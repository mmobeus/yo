+//! Codenames, titles and truncation.
+
+/// Shortens `title` to at most `max` characters, ending with "…" when cut.
+pub fn truncate_title(title: &str, max: usize) -> String {
+    if title.chars().count() <= max {
+        return title.to_string();
+    }
+    let keep = max.saturating_sub(1);
+    let mut out: String = title.chars().take(keep).collect();
+    out.push('…');
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::truncate_title;
+
+    #[test]
+    fn short_titles_are_unchanged() {
+        assert_eq!(truncate_title("sweep", 10), "sweep");
+        assert_eq!(truncate_title("exactly10!", 10), "exactly10!");
+    }
+
+    #[test]
+    fn long_titles_are_cut_with_an_ellipsis() {
+        assert_eq!(truncate_title("a very long title", 8), "a very …");
+        assert_eq!(truncate_title("ééééé", 3), "éé…");
+    }
+
+    #[test]
+    fn zero_leaves_only_the_ellipsis() {
+        assert_eq!(truncate_title("anything", 0), "…");
+    }
+}
