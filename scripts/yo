#!/usr/bin/env bash
#
# yo — spin up / tear down an iTerm2 work session on a fresh git worktree.
#
# Configuration:
#   Every site-specific thing (which repos exist, where their clones live, the
#   branch prefix, window size) lives in a JSON config file — this script
#   itself is generic. yo reads, in order:
#       $YO_CONFIG
#       ${XDG_CONFIG_HOME:-~/.config}/yo/config.json
#   The file holds "defaults" (global settings), "profiles" (each with its own
#   settings, and the repos and agents inside it) and repos and agents that
#   belong to no profile. A profile's "owners" claim GitHub owners: every clone
#   at <cloneRoot>/<owner>/* joins it, and so does a PR/issue URL for one. See
#   config/yo.config.example.json, `_yo_cfg` below for every key, and `yo
#   config` for the commands that edit it. A setting already in the
#   environment (YO_MODE=here yo ...) beats the file.
#   With no config file, yo runs in single-repo mode: the clone you are standing
#   in is the repo and its default branch is the base branch. `yo help` prints
#   the repos yo can currently see.
#
# Usage:
#   yo [--repo=R] [--profile=P] [--here|--worktree] [--title=T] [--from=S]
#      [--model=M] [--agent=NAME] [--add-to=PROFILE|guest] [INPUT] [extra]
#
#   INPUT is resolved in order:
#     PR / issue URL     github.com/.../pull/N or /issues/N (see below)
#     existing branch    exact branch name (local or origin) -> reused as-is;
#                        also matches <prefix>/<INPUT> (the classic reuse case)
#     session name       otherwise: new branch <prefix>/<INPUT> off the repo's
#                        base branch
#     - or (omitted)     timestamped session (sesh_YYYYmmdd_HHMMSS) with a fun
#                        window title ("Adventurous Possum"). `-` is the
#                        explicit spelling so an [extra] can follow:
#                          yo - 'prod is broken, investigate!'
#                        Bare `yo` works too: repo = --repo, else inferred
#                        from the cwd, else the default repo. Help is `yo help`.
#
#   --repo=R overrides repo inference — e.g. work in one repo on an issue that
#   is tracked in another:
#     yo --repo=backend https://github.com/acme/tracker/issues/123
#   (For PR URLs the worktree must come from the PR's own repo, so a
#   conflicting --repo is an error.) The legacy positional form
#   `yo <repo> <name> [extra]` still works.
#
#   URL forms (repo, kind, and number are read from the URL):
#     .../pull/<n>    -> name review_pr_<n>; worktree checked out at the PR's
#                        HEAD (the code under review, via refs/pull/<n>/head)
#                        and set to TRACK it so `git pull` refreshes as the PR
#                        gets new commits; seeds claude with  /code-review <url>
#                        (the command is configurable — YO_REVIEW_CMD).
#     .../issues/<n>  -> name issue_<n> (off the repo's base branch); seeds
#                        claude with a "help me address this issue: <url>"
#                        message.
#
#   A clone whose origin is your fork works as well: the real repo is whichever
#   remote points at the repo's owner/repo (conventionally `upstream`), and PR
#   heads and the base branch are fetched from there; your own branches still
#   come from origin.
#
#   A URL for a repo yo has never heard of works too: the repo is cloned to
#   <cloneRoot>/<owner>/<repo> (or found there, if it already is) and the
#   session gets a worktree off it as usual. Where it belongs:
#     - a profile that claims its owner: it joins that profile, no questions;
#     - --add-to=PROFILE: it joins PROFILE, and is saved there in the config;
#     - otherwise, at a terminal, yo asks: one of your profiles (saved), a new
#       profile claiming its owner (saved), or a guest just this once;
#     - with nobody to ask (no terminal, or from inside claude), a guest.
#   A guest gets no shared memory (Claude keeps its own), and its worktree is
#   NOT pre-trusted — Claude asks before running anything the repo configures.
#   (A profile with "trust": false does the same for its own repos.) The
#   "guestProfile" default names a profile to run guests under instead.
#
#   Window titles: non-default repos get a "[<repo>] " prefix; PR/issue
#   sessions show "PR#1234: <title>" / "Issue#1234: <title>" (fetched via gh,
#   truncated to 50 chars; falls back to the session name if gh fails).
#
#   Personas: EVERY session gets a codename ("Adventurous Possum") told to
#   claude in its first message — it introduces itself with it, and unnamed
#   sessions use it as the window title.
#
#   --title="T"  use T as the tab / Session Status title instead of the derived
#   one (session name, PR/issue title, or codename). Retitle later, from inside
#   the session, with `yo title`.
#
#   --from=SESSION  tell the new session to report back to the Claude session
#   named SESSION (the name the statusline shows, what SendMessage takes) when
#   it finishes or gets blocked. For a coordinating session handing work out.
#
#   --model=M  run this session on model M (an alias like opus, sonnet, haiku,
#   opus[1m], or a full model id). Session only: your default in settings.json
#   is untouched, and resume keeps the session on whatever it last ran on.
#   `yo resume --model=M <session>` switches a session as it comes back.
#
#   --agent=NAME  run the session AS agent NAME (claude --agent): its system
#   prompt and rules instead of the default ones. NAME must be an agent merged on
#   the repo's base branch (a .claude/agents/*.md file with `name: NAME`) or one
#   in ~/.claude/agents. The ledger records it, so resume and resume-all bring
#   the session back as the same agent. The tab and the codename lead with the
#   agent's name ("Cindy · Plucky Gary"), and an issue or PR URL is handed to the
#   agent to work or review by its own instructions. An agent registered with
#   in the config ("agents") defaults the repo to its own.
#     yo --agent=cindy https://github.com/acme/service/issues/123
#
#   --new-window (--window) put this session in a NEW iTerm window instead of a
#   tab in the shared one; --tab forces the opposite. The default is a tab, so
#   sessions pile up in one window and iTerm2's Session Status tool — which only
#   lists the sessions of ONE window — becomes a dashboard of all of them.
#   (Window > Cockpit, ⌥⇧⌘C, shows status across every window regardless.)
#   YO_WINDOW_MODE=window in the config restores one window per session;
#   YO_WINDOW_GROUP names the shared window, and may contain {repo} to get one
#   window per repo.
#
#   --here (--in-place) NO worktree, NO branch: the session runs in an existing
#   directory, on whatever is checked out there. Nothing is fetched or created.
#   Which directory:
#     a repo you NAMED (--repo, `yo <repo>`, a PR/issue URL)  -> its clone
#     otherwise                                               -> the cwd, which
#                                       needn't be a git clone at all
#   INPUT is then only the session's title. A PR/issue URL still seeds claude,
#   but checks nothing out — yo says so, since the tree may be stale.
#   Made for handing work from one session to the next in the same tree:
#     yo --here - 'read HANDOFF.md, then ask the previous session what is open'
#   In place can be the DEFAULT — per repo ("mode": "here"), per profile, or
#   everywhere (defaults.mode); --worktree then asks for a worktree this
#   once.
#
#   --profile=P (or `yo <profile>`) run the session under a profile: a named
#   bundle of defaults for one of YOUR projects — mode, memory, branch prefix,
#   the claude command, a settings layer (permissions, hooks, ...), a home
#   directory. Repos listed inside a profile (or under an owner it claims) get
#   it without asking. A profile also stands on its own: with no repo named,
#     yo --profile=P      goes to the profile's "dir" (which needn't be a git
#                         clone), else to the cwd's repo if it belongs to P,
#                         else to the first repo registered under P.
#   Precedence, everywhere: flag > repo > profile > defaults.
#
#   Layout (YO_LAYOUT): `split` puts a shell pane next to claude; `workgroup`
#   opens claude alone and leaves the shell to the terminal peer ("CLI") of
#   iTerm2's Claude Code workgroup. The default, `auto`, picks `workgroup` when
#   that workgroup has a peer session configured, else `split`.
#
#   yo down [--dry-run] [--yes [--discard]]
#                        Tear down the session you're currently in
#                        (aliases: rm, teardown, -d). In a --here session there
#                        is no worktree to remove, so it only forgets the
#                        session and closes the tab. --yes skips the prompt so
#                        it can run from inside claude (the /yo-down skill); it
#                        refuses to lose uncommitted work unless --discard.
#                        --dry-run reports what would happen and stops.
#   yo agent [NAME] [--model=M] [--new-window|--tab] ['message']
#                        Start, or bring back, agent NAME's home session: a
#                        long-lived checkout of the repo's base branch at
#                        <clone>-worktrees/agent-NAME (detached, refreshed from
#                        the base each time it starts while it's clean), run as
#                        the agent with Remote Control on, named NAME-home. Its
#                        work happens in worker sessions it starts with
#                        `yo --agent=NAME --from=NAME-home ...`, never in the
#                        home checkout, which `yo down` and `yo sweep` leave
#                        alone. Bare `yo agent` lists the registered agents.
#                        A message is delivered whichever way the home is
#                        reached: seeded into a new or resumed home, or, when
#                        it's already running, typed into its prompt after its
#                        iTerm tab is brought forward.
#   yo NAME ['message']  With no flags, reaches what NAME names, in order:
#                          1. an agent registered in the config: its home, as
#                             `yo agent NAME`;
#                          2. a live session by its Claude name (what the
#                             statusline and ListAgents show, or a Remote
#                             Control name such as cindy-home): its iTerm tab
#                             comes forward and the message is typed into its
#                             prompt;
#                          3. a session in yo's ledger, by its yo name, session
#                             id or id prefix: brought forward and typed into
#                             if running, else resumed with the message as its
#                             first prompt;
#                          4. a repo named NAME-home (its key, or its clone's
#                             directory name): the home's session — brought
#                             forward and typed into if one is running, else
#                             the most recently used one resumed with the
#                             message, else a new one started in place there,
#                             seeded with it;
#                          5. otherwise a new session named NAME, as always.
#                        A repo or profile NAME keeps its own meaning (`yo
#                        <repo>`), any flag skips 1-4 (`yo --repo=R NAME`), and
#                        an existing branch is still named by its full name
#                        (`yo <prefix>/NAME`).
#   yo sessions          List the sessions yo knows about and whether each is
#                        running, ready to resume, or gone (alias: ls).
#   yo resume <name|session-id|dir> [--model=M] [--new-window|--tab]
#                        Reopen one session in a tab of its shared window and
#                        `claude --resume` it there, under the same repo,
#                        profile and settings layer it started with (alias:
#                        --resume). Any session id works, even one yo didn't
#                        start: its directory is read from the transcript.
#   yo title ["T"]       Retitle the session this runs in (tab, Session Status
#                        and the ledger; the /yo-title skill). Bare `yo title`
#                        resets every yo tab's name to its title, undoing the
#                        workgroup's "Chat" rename.
#   yo adopt [--title=T] Run from inside a claude session yo didn't start (the
#                        /yo-adopt skill): record it so resume-all brings it
#                        back. Works anywhere, not just in a yo worktree.
#   yo forget <name|session-id|dir>
#                        Drop a session from the ledger (resume-all skips it);
#                        its transcript and directory are left alone.
#   yo resume-all [--dry-run] [--new-window|--tab]
#                        After a restart or crash: reopen every session that
#                        was live, one tab each. Sessions quit with /exit are
#                        left out (yo resume <name> still reopens one).
#   yo sweep [--apply] [--repo=R]... [--include-stale] [--include-suspended]
#            [--delete-branches]
#                        Find worktrees whose work has landed and (with --apply)
#                        remove them; dry run by default. DEAD = merged PR (a
#                        squash merge leaves the PR as the only witness), no
#                        commits beyond base, or a clean PR-review checkout.
#                        STALE = unmerged work, kept. SUSP = a session the
#                        ledger would resume, kept. KEEP = dirty, open PR, the
#                        current directory, or a live claude session. Branches
#                        are kept unless --delete-branches; removal never uses
#                        --force.
#   yo config [show | path | edit | add-repo <clone|url|owner/repo>
#             [--profile=P] [--key=K]]
#                        Show the config and what it registers; open it in
#                        $EDITOR (validated after); or list a repo, cloning it
#                        first unless it's a directory.
#   yo help              Show this help, plus the configured repos and profiles.
#
# Session ledger: yo records each session's id under
# ${XDG_STATE_HOME:-~/.local/state}/yo/sessions/, because Claude Code's own
# list of running sessions doesn't survive a restart (the first claude started
# afterwards prunes the rest). `yo sessions` also adopts sessions that are
# running in a yo worktree but were started some other way — run it before a
# planned restart to make sure resume-all will know about them.
#
# [extra] — optional final argument: additional instructions appended to the
# initial message seeded into claude (PR/issue modes), or used AS the initial
# message for a plain <name> session (which otherwise seeds nothing). Quote it:
#   yo <repo> my-fix 'focus on the retry path; skip tests for now'
#
# What "create" does:
#   1. fetch the repo's base branch in the primary clone
#   2. worktree add  <clone>-worktrees/<name>  on branch  <prefix>/<name> —
#      REUSED if it already exists locally (must not be checked out elsewhere),
#      created tracking origin/<prefix>/<name> if that exists, else created
#      fresh from the base branch (or the PR's head commit in PR-review mode)
#   3. open a tab titled <name> in the shared iTerm2 window (creating that
#      window if it isn't open yet)
#   4. split the tab side-by-side; cd both panes to the worktree (layout
#      `split` — under `workgroup` there is one pane and no split)
#   5. seed the worktree's trust record in ~/.claude.json so no folder-trust
#      dialog appears, and copy the base clone's .claude/settings.local.json
#      (gitignored, holds MCP-server approvals) so the MCP prompt is skipped too
#   6. launch claude in the LEFT pane (with an initial message pre-filled when
#      created from a PR/issue URL), under a session id yo picks and records
#      in the session ledger, stacking yo's settings layer on top of your own
#      with `claude --settings`: the installed claude-settings.json plus an
#      autoMemoryDirectory — one memory shared by every session
#      (~/.claude/memories/yo unless YO_MEMORIES / YO_MEMORY_STORE say
#      otherwise) — plus the hooks that keep the ledger current.
#      ~/.claude/settings.json is never edited.
#
# What "down" does (from inside the worktree: the right pane, or claude itself):
#   - warns loudly about uncommitted / unpushed work
#   - confirms, removes the worktree, KEEPS the branch, forgets the session
#   - closes ITS OWN iTerm2 tab (and the window with it, if it was the last
#     tab) — found by session id, so it's safe when another tab has focus
#
set -euo pipefail

# Set by _yo_apply_defaults() after the config file has had its say.
BRANCH_PREFIX=""
CLAUDE_CMD=""
WIN_WIDTH=0
WIN_HEIGHT=0
YO_REVIEW_CMD_RESOLVED=""
WORKSESH_PROFILE_NAME=""
YO_WINDOW_MODE_RESOLVED=""
YO_WINDOW_GROUP_RESOLVED=""
YO_LAYOUT_RESOLVED=""
YO_CONFIG_PATH=""
YO_MODE_RESOLVED=""
YO_CLONE_ROOT_RESOLVED=""
YO_CLONE_PROTOCOL_RESOLVED=""
YO_GUEST_REPO=""     # key of the guest repo register_url_repo registered, if it did
YO_URL_REPO=""       # key of any repo register_url_repo registered
YO_PROFILE_SELECTED=""   # --profile / `yo <profile>`; beats a repo's own
YO_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yo/sessions"
YO_CLAUDE_LINE=""        # set by prepare_claude_cmd

# This script's own path, for the hooks it injects into claude. Deliberately
# NOT symlink-resolved: an installed ~/.local/bin/yo stays the hook target, so
# updating the checkout updates the hook too.
case "$0" in
  /*) YO_SELF="$0" ;;
  *)  YO_SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" ;;
esac

die() { printf '%s: %s\n' "$(basename "$0")" "$*" >&2; exit 1; }

# Wrap a string in single quotes for safe embedding in a shell command line,
# using the standard '\'' dance for embedded single quotes. Preferred over
# printf %q, which backslash-escapes every space and makes the resulting
# command line unreadable in the pane.
shell_single_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

# Elasticsearch-node-style persona: "Boring Jason", "Adventurous Possum", ...
# EVERY session gets one (told to claude up front); it doubles as the window
# title for unnamed sessions. ~48x48 combos so parallel sessions rarely collide.
fun_session_title() {
  local adjectives=(Boring Adventurous Sleepy Dapper Cosmic Sneaky Gentle Rowdy
    Prudent Spicy Mellow Frantic Stoic Jaunty Grumpy Plucky Serene Wobbly
    Shrewd Zesty Bashful Intrepid Crispy Solemn Feral Suave Skittish Vigilant
    Peppy Somber Nimble Brooding Chipper Wily Earnest Snazzy Groggy Dauntless
    Fussy Breezy Stalwart Quirky Placid Rambunctious Meek Swanky Restless Deft)
  local nouns=(Jason Possum Wombat Heron Badger Otter Lemur Marmot Falcon
    Walrus Gecko Bison Ferret Puffin Stoat Ibex Newt Mongoose Tapir Quokka
    Capybara Osprey Vole Axolotl Gary Marlene Nigel Beatrice Clarence Doreen
    Pangolin Numbat Kestrel Shrike Muskrat Bandicoot Gibbon Tamarin Loon
    Kinkajou Hoopoe Dugong Marmoset Petrel Stanley Agnes Wendell Petunia)
  printf '%s %s' "${adjectives[RANDOM % ${#adjectives[@]}]}" \
    "${nouns[RANDOM % ${#nouns[@]}]}"
}

# Truncate to 50 chars with an ellipsis (window titles stay scannable).
truncate_title() {
  local s="$1"
  if [ "${#s}" -le 50 ]; then printf '%s' "$s"; else printf '%s…' "${s:0:49}"; fi
}

usage() {
  # Print the contiguous comment header (from line 3, past the shebang) up to
  # the first non-comment line, stripping the leading "# ". Line-count-agnostic
  # so edits to the header above don't desync a hard-coded range.
  awk 'NR>=3 { if ($0 ~ /^#/) { sub(/^# ?/, ""); print; next } else exit }' "$0"

  # Then the live registry, so `yo help` answers "what can I say for --repo?"
  _yo_print_registry
}

_yo_print_registry() {
  echo "configured repos:"
  if [ -n "${YO_CONFIG_PATH:-}" ]; then
    echo "  (from $YO_CONFIG_PATH)"
  else
    echo "  (no config file — single-repo mode, inferred from the current clone)"
  fi
  local k path base mark
  for k in $(_yo_repo_keys); do
    path=$(_yo_field "$k" 2)
    base=$(base_ref_for "$k" 2>/dev/null || echo '?')
    mark=" "
    [ "$k" = "$(default_repo_key)" ] && mark="*"
    [ "$(mode_for "$k")" = "here" ] && base="$base, in place"
    [ -n "$(_yo_field "$k" 11)" ] && base="$base, profile: $(_yo_field "$k" 11)"
    printf '  %s %-12s %s (base: %s)\n' "$mark" "$k" "$path" "$base"
  done
  echo "  (* = default)"
  if [ -n "$_YO_PROFILES" ]; then
    echo "profiles:"
    local n d o r
    for n in $(_yo_profile_names); do
      d=$(_yo_pfield "$n" 7)
      o=$(_yo_pfield "$n" 9)
      r=$(_yo_repos_of_profile "$n" | paste -sd' ' -)
      printf '    %-12s %s\n' "$n" "${d:+$d  }${o:+owners: $o  }repos: ${r:-(none)}"
    done
  fi
  if [ -n "$_YO_AGENTS" ]; then
    echo "agents:"
    local a
    for a in $(_yo_agent_names); do
      printf '    %-12s repo: %s\n' "$a" "$(_yo_agent_field "$a" 2)"
    done
  fi
}

# --- repo registry -----------------------------------------------------------
# Repos are registered by calling yo_repo: the config's loader (_yo_cfg load)
# emits the calls. Records live in one newline-separated string, TAB-separated
# fields, because macOS ships bash 3.2 — no associative arrays.
#
# fields: 1=key 2=path 3=base 4=github 5=mcp 6=mirror 7=title-prefix 8=memory
#         9=branch-prefix 10=mode 11=profile
_YO_REPOS=""
_YO_TAB=$(printf '\t')

yo_repo() {
  local key="${1:-}"; shift || true
  local path="" base="" gh="" mcp="" mirror="" prefix="__auto__" memory="" a
  local branch_prefix="" mode="" profile=""
  [ -n "$key" ] || die "yo_repo: missing repo key"
  case "$key" in
    *[!A-Za-z0-9._-]*) die "yo_repo: key may only contain letters, digits, . _ - (got: '$key')" ;;
  esac
  for a in "$@"; do
    case "$a" in
      --path=*)         path="${a#--path=}" ;;
      --base=*)         base="${a#--base=}" ;;
      --github=*)       gh="${a#--github=}" ;;
      --mcp=*)          mcp="${a#--mcp=}" ;;
      --mirror=*)       mirror="${a#--mirror=}" ;;
      --title-prefix=*) prefix="${a#--title-prefix=}" ;;
      --memory=*)       memory="${a#--memory=}" ;;
      --branch-prefix=*) branch_prefix="${a#--branch-prefix=}" ;;
      --profile=*)      profile="${a#--profile=}" ;;
      --mode=*)         mode="${a#--mode=}"
                        case "$mode" in
                          here|worktree) : ;;
                          *) die "yo_repo $key: --mode must be 'here' or 'worktree' (got: '$mode')" ;;
                        esac ;;
      *) die "yo_repo $key: unknown option '$a'" ;;
    esac
  done
  [ -n "$path" ] || die "yo_repo $key: --path is required"
  _yo_field "$key" 1 >/dev/null 2>&1 && die "yo_repo: '$key' is already registered"
  _YO_REPOS="${_YO_REPOS}${key}${_YO_TAB}${path}${_YO_TAB}${base}${_YO_TAB}${gh}${_YO_TAB}${mcp}${_YO_TAB}${mirror}${_YO_TAB}${prefix}${_YO_TAB}${memory}${_YO_TAB}${branch_prefix}${_YO_TAB}${mode}${_YO_TAB}${profile}
"
}

# Register every git clone directly under <dir>, keyed by directory name — for
# an org's worth of repos. Any further arguments are yo_repo options applied to
# each (--mode=here, --profile=...). Keys that are already registered are left
# alone, so give the special cases their own yo_repo line FIRST.
yo_repos_in() {
  local dir="${1:-}" d key
  [ -n "$dir" ] || die "yo_repos_in: missing directory"
  shift
  case " $* " in *" --path="*) die "yo_repos_in $dir: --path is what it works out itself" ;; esac
  for d in "$dir"/*/; do
    d="${d%/}"
    [ -e "$d/.git" ] || continue
    key=$(basename "$d")
    case "$key" in *[!A-Za-z0-9._-]*) continue ;; esac
    _yo_field "$key" 1 >/dev/null 2>&1 && continue
    yo_repo "$key" --path="$d" "$@"
  done
}

# --- agents -------------------------------------------------------------------
# Agents are registered by calling yo_agent, the same way as repos.
# fields: 1=name 2=repo 3=title
_YO_AGENTS=""

yo_agent() {
  local name="${1:-}"; shift || true
  local repo="" title="" a
  [ -n "$name" ] || die "yo_agent: missing agent name"
  _yo_agent_name_ok "$name" || die "yo_agent: name may only contain letters, digits, . _ - (got: '$name')"
  for a in "$@"; do
    case "$a" in
      --repo=*)  repo="${a#--repo=}" ;;
      --title=*) title="${a#--title=}" ;;
      *) die "yo_agent $name: unknown option '$a'" ;;
    esac
  done
  [ -n "$repo" ] || die "yo_agent $name: --repo is required"
  _yo_agent_field "$name" 1 >/dev/null 2>&1 && die "yo_agent: '$name' is already registered"
  _YO_AGENTS="${_YO_AGENTS}${name}${_YO_TAB}${repo}${_YO_TAB}${title}
"
}

_yo_agent_field() {
  printf '%s\n' "$_YO_AGENTS" \
    | awk -F'\t' -v k="$1" -v n="$2" '$1==k { print $n; f=1; exit } END { exit f?0:1 }'
}

_yo_agent_names() { printf '%s\n' "$_YO_AGENTS" | awk -F'\t' 'NF { print $1 }'; }

_yo_agent_name_ok() {
  case "$1" in ""|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

# The name an agent's tabs and codenames lead with: its yo_agent --title, else
# the name with its first letter capitalized (bash 3.2: no ${x^}).
_yo_agent_display() {
  local t
  t=$(_yo_agent_field "$1" 3 2>/dev/null || true)
  if [ -n "$t" ]; then printf '%s' "$t"; return 0; fi
  printf '%s' "$1" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }'
}

# Refuses an agent claude can't find, before anything is created. With a ref,
# looks in the repo's committed .claude/agents at that ref (merged agents only);
# without one, in DIR/.claude/agents on disk. ~/.claude/agents always counts.
_yo_agent_check() {
  local name="$1" dir="$2" ref="${3:-}" pat
  pat="^name:[[:space:]]*[\"']?${name}[\"']?[[:space:]]*\$"
  if [ -n "$ref" ]; then
    git -C "$dir" grep -q -E "$pat" "$ref" -- .claude/agents 2>/dev/null && return 0
  elif [ -d "$dir/.claude/agents" ]; then
    grep -rqE "$pat" "$dir/.claude/agents" 2>/dev/null && return 0
  fi
  [ -d "$HOME/.claude/agents" ] && grep -rqE "$pat" "$HOME/.claude/agents" 2>/dev/null && return 0
  die "no agent named '$name' in ${ref:+$ref:}.claude/agents of $dir, or in ~/.claude/agents
        yo starts only agents that are merged (or installed in ~/.claude/agents)"
}

# " --agent 'NAME'" for a claude command line, or nothing.
_yo_agent_arg() {
  [ -n "$1" ] || return 0
  printf ' --agent %s' "$(shell_single_quote "$1")"
}

# " --name 'NAME' --remote-control 'NAME'" for a claude command line, or nothing.
# The session takes the Remote Control name as its own too: otherwise Claude
# derives one from the directory (agent-cindy-52), and that is the name
# ListAgents, SendMessage and a worker's --from see.
_yo_rc_arg() {
  [ -n "$1" ] || return 0
  local q; q=$(shell_single_quote "$1")
  printf ' --name %s --remote-control %s' "$q" "$q"
}

# Field <n> of the record for repo <key>. Non-zero exit if the key is unknown.
_yo_field() {
  printf '%s\n' "$_YO_REPOS" \
    | awk -F'\t' -v k="$1" -v n="$2" '$1==k { print $n; f=1; exit } END { exit f?0:1 }'
}

_yo_repo_keys() { printf '%s\n' "$_YO_REPOS" | awk -F'\t' 'NF { print $1 }'; }

# Human-readable list for error messages: "backend | frontend | yo"
_yo_repo_list() { _yo_repo_keys | paste -sd'|' - | sed 's/|/ | /g'; }

# The repo bare `yo` falls back to: YO_DEFAULT_REPO if it names a registered
# repo, else the first one registered.
default_repo_key() {
  if [ -n "${YO_DEFAULT_REPO:-}" ] && _yo_field "$YO_DEFAULT_REPO" 1 >/dev/null 2>&1; then
    printf '%s' "$YO_DEFAULT_REPO"
  else
    _yo_repo_keys | head -1
  fi
}

# repo key -> absolute path of the primary clone
repo_path_for() { _yo_field "$1" 2; }

# owner/repo out of any github remote or web URL (first two path segments).
# Exact-match material, so `foo/bar` can't be mistaken for `foo/bar-baz`.
_yo_owner_repo_from_url() {
  local u="${1%.git}" rest owner repo
  case "$u" in
    *github.com:*) rest="${u#*github.com:}" ;;
    *github.com/*) rest="${u#*github.com/}" ;;
    *) return 1 ;;
  esac
  rest="${rest#/}"
  case "$rest" in */*) : ;; *) return 1 ;; esac   # need both segments
  owner="${rest%%/*}"
  rest="${rest#*/}"
  repo="${rest%%/*}"
  repo="${repo%.git}"
  [ -n "$owner" ] && [ -n "$repo" ] || return 1
  printf '%s/%s' "$owner" "$repo"
}

# owner/repo out of a conventional .../github.com/<owner>/<repo> checkout path.
# Only fires when the path literally contains github.com/, so it can't invent an
# owner for a clone kept somewhere else.
_yo_owner_repo_from_path() {
  local rest owner repo
  case "$1" in */github.com/*/*) rest="${1#*/github.com/}" ;; *) return 1 ;; esac
  rest="${rest%/}"
  owner="${rest%%/*}"
  rest="${rest#*/}"
  repo="${rest%%/*}"
  [ -n "$owner" ] && [ -n "$repo" ] || return 1
  printf '%s/%s' "$owner" "$repo"
}

# repo key -> owner/repo, tried three ways: the explicit --github, then the
# clone's own remotes (authoritative) — `upstream` before `origin`, since a
# clone of your fork conventionally keeps the real repo as `upstream` — then
# the checkout path. The last one matters because a repo can be configured
# before it has been cloned on this machine — without it, a PR URL for an
# uncloned repo looks unrecognized.
_yo_github_for() {
  local key="$1" gh path url r
  gh=$(_yo_field "$key" 4) || return 1
  [ -n "$gh" ] && { printf '%s' "$gh"; return 0; }
  path=$(_yo_field "$key" 2) || return 1
  for r in upstream origin; do
    if url=$(git -C "$path" remote get-url "$r" 2>/dev/null); then
      _yo_owner_repo_from_url "$url" && return 0
    fi
  done
  _yo_owner_repo_from_path "$path"
}

# repo key -> the remote that IS the repo on GitHub: the one whose URL matches
# the repo's owner/repo. A clone whose origin is a personal fork keeps the real
# repo as another remote (conventionally `upstream`), and that is where a PR's
# refs/pull/<n>/head and the base branch live; your own branches still live on
# origin. Falls back to origin, so a clone of the repo itself is unchanged.
_yo_upstream_remote() {
  local key="$1" path want r url
  path=$(_yo_field "$key" 2) || { printf 'origin'; return 0; }
  want=$(_yo_github_for "$key" 2>/dev/null) || { printf 'origin'; return 0; }
  for r in $(git -C "$path" remote 2>/dev/null); do
    url=$(git -C "$path" remote get-url "$r" 2>/dev/null) || continue
    [ "$(_yo_owner_repo_from_url "$url" 2>/dev/null)" = "$want" ] && { printf '%s' "$r"; return 0; }
  done
  printf 'origin'
}

# Registered repos whose owner/repo we can't work out at all — the thing that
# actually explains an "unrecognized repo in URL" for a repo that IS configured.
_yo_unresolved_repos() {
  local key out=""
  for key in $(_yo_repo_keys); do
    _yo_github_for "$key" >/dev/null 2>&1 || out="$out $key"
  done
  printf '%s' "${out# }"
}

# The clone's default branch, for repos registered without --base.
_yo_default_branch() {
  local path="$1" ref
  if ref=$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s' "${ref#origin/}"; return 0
  fi
  for ref in main master dev; do
    if git -C "$path" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
      printf '%s' "$ref"; return 0
    fi
  done
  printf 'main'
}

# repo key -> primary work branch (what new sessions branch from and what
# teardown's "unpushed" check compares against)
base_ref_for() {
  local base
  base=$(_yo_field "$1" 3) || return 1
  if [ -z "$base" ]; then
    base=$(_yo_default_branch "$(_yo_field "$1" 2)")
  fi
  printf '%s' "$base"
}

# repo key -> MCP servers (from the repo's .mcp.json) pre-approved for every
# session. Space-separated.
mcp_servers_for() { _yo_field "$1" 5 2>/dev/null || printf ''; }

# repo key -> gitignored, machine-local files each worktree needs a copy of.
mirrored_repo_files_for() { _yo_field "$1" 6 2>/dev/null || printf ''; }

# repo key -> iTerm window-title prefix. Default: "[key] " for every repo but
# the default one, which gets none.
title_prefix_for() {
  local p
  p=$(_yo_field "$1" 7) || return 0
  if [ "$p" = "__auto__" ]; then
    [ "$1" = "$(default_repo_key)" ] && return 0
    printf '[%s] ' "$1"
  else
    printf '%s' "$p"
  fi
}

# --- profiles -----------------------------------------------------------------
# A profile is a named bundle of defaults for one of your projects. Repos join
# one (in the config, by being listed inside it, or by belonging to a GitHub
# owner it claims), and it can be picked on its own with --profile. Same
# storage as the repos.
#
# fields: 1=name 2=mode 3=memory 4=branch-prefix 5=claude 6=settings 7=dir
#         8=window-group 9=owners (space-separated) 10=trust (0 = don't
#         pre-trust its worktrees)
_YO_PROFILES=""

yo_profile() {
  local name="${1:-}"; shift || true
  local mode="" memory="" branch_prefix="" claude="" settings="" dir="" group="" a
  local owners="" trust=1
  [ -n "$name" ] || die "yo_profile: missing profile name"
  case "$name" in
    *[!A-Za-z0-9._-]*) die "yo_profile: name may only contain letters, digits, . _ - (got: '$name')" ;;
  esac
  for a in "$@"; do
    case "$a" in
      --mode=*)          mode="${a#--mode=}"
                         case "$mode" in
                           here|worktree) : ;;
                           *) die "yo_profile $name: --mode must be 'here' or 'worktree' (got: '$mode')" ;;
                         esac ;;
      --memory=*)        memory="${a#--memory=}" ;;
      --branch-prefix=*) branch_prefix="${a#--branch-prefix=}" ;;
      --claude=*)        claude="${a#--claude=}" ;;
      --settings=*)      settings=$(_yo_expand_home "${a#--settings=}") ;;
      --dir=*)           dir=$(_yo_expand_home "${a#--dir=}"); dir="${dir%/}" ;;
      --window-group=*)  group="${a#--window-group=}" ;;
      --owners=*)        owners="${a#--owners=}" ;;
      --trust=*)         case "${a#--trust=}" in
                           yes|1|true) trust=1 ;;
                           no|0|false) trust=0 ;;
                           *) die "yo_profile $name: --trust must be yes or no (got: '${a#--trust=}')" ;;
                         esac ;;
      *) die "yo_profile $name: unknown option '$a'" ;;
    esac
  done
  _yo_pfield "$name" 1 >/dev/null 2>&1 && die "yo_profile: '$name' is already defined"
  _YO_PROFILES="${_YO_PROFILES}${name}${_YO_TAB}${mode}${_YO_TAB}${memory}${_YO_TAB}${branch_prefix}${_YO_TAB}${claude}${_YO_TAB}${settings}${_YO_TAB}${dir}${_YO_TAB}${group}${_YO_TAB}${owners}${_YO_TAB}${trust}
"
}

# The profile that claims GitHub owner <owner> (case-insensitive), if any.
_yo_profile_for_owner() {
  printf '%s\n' "$_YO_PROFILES" | awk -F'\t' -v o="$1" '
    NF { n = split($9, a, " "); for (i = 1; i <= n; i++) if (tolower(a[i]) == tolower(o)) { print $1; f = 1; exit } }
    END { exit f ? 0 : 1 }'
}

# Whether yo pre-trusts repo <key>'s worktrees: not a guest's, and not one in a
# profile with trust off. Untrusted ones get Claude's trust prompt.
repo_trusted() {
  local p
  [ "$1" = "$YO_GUEST_REPO" ] && return 1
  p=$(_yo_field "$1" 11 2>/dev/null || true)
  [ -z "$p" ] || [ "$(_yo_pfield "$p" 10 2>/dev/null)" != "0" ]
}

# A leading ~/ written inside quotes in the config never met the shell.
_yo_expand_home() {
  case "$1" in
    "~")   printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${1#"~/"}" ;;
    *)     printf '%s' "$1" ;;
  esac
}

# Field <n> of profile <name>. Non-zero exit if there is no such profile.
_yo_pfield() {
  printf '%s\n' "$_YO_PROFILES" \
    | awk -F'\t' -v k="$1" -v n="$2" '$1==k { print $n; f=1; exit } END { exit f?0:1 }'
}

_yo_profile_names() { printf '%s\n' "$_YO_PROFILES" | awk -F'\t' 'NF { print $1 }'; }

# The repos registered under profile <name>, in registration order.
_yo_repos_of_profile() {
  printf '%s\n' "$_YO_REPOS" | awk -F'\t' -v p="$1" 'NF && $11==p { print $1 }'
}

# The repo whose primary clone IS <dir>, if any.
_yo_repo_at() {
  printf '%s\n' "$_YO_REPOS" \
    | awk -F'\t' -v d="${1%/}" 'NF { p=$2; sub(/\/$/, "", p); if (p==d) { print $1; f=1; exit } } END { exit f?0:1 }'
}

# The profile a session in repo <key> (may be empty) runs under: the one picked
# on the command line, else the repo's own. Empty when neither.
profile_for() {
  if [ -n "$YO_PROFILE_SELECTED" ]; then
    printf '%s' "$YO_PROFILE_SELECTED"
  elif [ -n "$1" ]; then
    _yo_field "$1" 11 2>/dev/null || true
  fi
}

# Field <n> of the profile behind repo <key>; empty when there's no profile.
_yo_profile_value() {
  local p
  p=$(profile_for "$1")
  [ -n "$p" ] || return 0
  _yo_pfield "$p" "$2" 2>/dev/null || true
}

# Every lookup below resolves the same way: the repo's own option, then its
# profile's, then the global setting.

# repo key -> prefix for the branches yo creates there.
branch_prefix_for() {
  local p
  p=$(_yo_field "$1" 9 2>/dev/null || true)
  [ -n "$p" ] || p=$(_yo_profile_value "$1" 4)
  printf '%s' "${p:-$BRANCH_PREFIX}"
}

# repo key (may be empty) -> here | worktree
mode_for() {
  local m=""
  [ -n "$1" ] && m=$(_yo_field "$1" 10 2>/dev/null || true)
  [ -n "$m" ] || m=$(_yo_profile_value "$1" 2)
  printf '%s' "${m:-$YO_MODE_RESOLVED}"
}

# repo key (may be empty) -> the command launched in the claude pane
claude_cmd_for() {
  local c
  c=$(_yo_profile_value "$1" 5)
  printf '%s' "${c:-$CLAUDE_CMD}"
}

# repo key (may be empty) -> the shared window its sessions join
window_group_for() {
  local g
  g=$(_yo_profile_value "$1" 8)
  printf '%s' "${g:-$YO_WINDOW_GROUP_RESOLVED}"
}

# The auto-memory directory for a session: ONE store shared by every session,
# whatever repo or directory it runs in, unless a repo asks for its own.
# YO_MEMORIES is the root (a memories checkout, once you have one) and the
# store inside it is the repo's --memory, else its profile's, else
# YO_MEMORY_STORE, else "yo".
# Echoes nothing — leaving Claude its own per-project memory — when the store
# is "none", or when YO_MEMORIES is set EMPTY, which turns all of this off.
memory_dir_for() {
  local repo_key="$1" store="" root
  root="${YO_MEMORIES-$HOME/.claude/memories}"
  [ -n "$root" ] || return 0
  [ -n "$repo_key" ] && store=$(_yo_field "$repo_key" 8 2>/dev/null || true)
  [ -n "$store" ] || store=$(_yo_profile_value "$repo_key" 3)
  store="${store:-${YO_MEMORY_STORE:-yo}}"
  [ "$store" = "none" ] && return 0
  case "$store" in
    /*) printf '%s' "$store" ;;
    *)  printf '%s/%s' "${root%/}" "$store" ;;
  esac
}

# origin URL (or any github URL) -> repo key
repo_key_from_url() {
  local url="$1" want key gh
  want=$(_yo_owner_repo_from_url "$url") || return 1
  for key in $(_yo_repo_keys); do
    gh=$(_yo_github_for "$key") || continue
    [ "$gh" = "$want" ] && { printf '%s' "$key"; return 0; }
  done
  return 1
}

# The repo the cwd belongs to: by its remotes (any of them — a fork clone has
# the registered repo as `upstream`), else — a clone that was never pushed has
# none — by being (a worktree of) a registered clone.
detect_repo_key() {
  local r url clone
  for r in $(git remote 2>/dev/null); do
    url=$(git remote get-url "$r" 2>/dev/null) || continue
    repo_key_from_url "$url" && return 0
  done
  clone=$(_yo_primary_clone) || return 1
  _yo_repo_at "$clone" || _yo_repo_at "$(cd "$clone" && pwd -P)"
}

# --- config -------------------------------------------------------------------
# The primary clone behind $PWD: in a worktree, --git-common-dir points at the
# main clone's .git; in the clone itself it is just ".git".
_yo_primary_clone() {
  local top common
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$common" in
    /*) dirname "$common" ;;
    *)  printf '%s' "$top" ;;
  esac
}

# No config file: register the clone we're standing in, so yo works unconfigured.
_YO_AUTOREG=""
_yo_autoregister() {
  local path
  path=$(_yo_primary_clone) || return 1
  _YO_AUTOREG=$(basename "$path")
  yo_repo "$_YO_AUTOREG" --path="$path"
}

# The config file: $YO_CONFIG, else config.json in yo's config directory.
_yo_config_path() {
  printf '%s' "${YO_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/yo/config.json}"
}

# The JSON config, read and written by one python3 helper.
#   load FILE                    bash that registers it all (eval'd by
#                                _yo_load_config); errors name the bad key
#   add-repo FILE PROFILE KEY PATH GITHUB
#                                list a repo (inside PROFILE, or at the top
#                                level when PROFILE is empty)
#   add-profile FILE NAME OWNER  a new profile that claims GitHub owner OWNER
#
# The file:
#   { "defaults": { ... },            global settings (see DEFAULTS below)
#     "profiles": { NAME: {
#         mode, memory, branchPrefix, claude, settings, dir, windowGroup,
#         owners: [github owner, ...]   every clone at <cloneRoot>/<owner>/*
#                                       joins, and so does a URL for one
#         trust: false                  don't pre-trust its worktrees
#         repos: { KEY: REPO }, reposIn: [DIR, ...], agents: { NAME: AGENT } } },
#     "repos": { KEY: REPO }, "reposIn": [DIR, ...], "agents": { NAME: AGENT } }
#   REPO:  { path, base, github, mcp, mirror, titlePrefix, memory,
#            branchPrefix, mode }       (path required; mcp/mirror: lists)
#   AGENT: { repo, title }              (repo required)
_yo_cfg() {
  python3 - "$@" <<'PY'
import json, os, shlex, sys

home = os.path.expanduser("~")
op, args = sys.argv[1], sys.argv[2:]

# defaults key -> the variable yo reads it from. A variable already set in the
# environment wins, so `YO_MODE=here yo ...` still works for one run.
DEFAULTS = {
    "branchPrefix": "YO_BRANCH_PREFIX", "mode": "YO_MODE",
    "claude": "YO_CLAUDE_CMD", "memories": "YO_MEMORIES",
    "memory": "YO_MEMORY_STORE", "settings": "YO_CLAUDE_SETTINGS",
    "layout": "YO_LAYOUT", "windowMode": "YO_WINDOW_MODE",
    "windowGroup": "YO_WINDOW_GROUP", "winWidth": "YO_WIN_WIDTH",
    "winHeight": "YO_WIN_HEIGHT", "itermProfile": "YO_ITERM_PROFILE",
    "reviewCmd": "YO_REVIEW_CMD", "defaultRepo": "YO_DEFAULT_REPO",
    "cloneRoot": "YO_CLONE_ROOT", "cloneProtocol": "YO_CLONE_PROTOCOL",
    "guestProfile": "YO_ADHOC_PROFILE",
}
PROFILE_OPTS = {"mode": "mode", "memory": "memory", "branchPrefix": "branch-prefix",
                "claude": "claude", "settings": "settings", "dir": "dir",
                "windowGroup": "window-group"}
REPO_OPTS = {"base": "base", "github": "github", "mcp": "mcp", "mirror": "mirror",
             "titlePrefix": "title-prefix", "memory": "memory",
             "branchPrefix": "branch-prefix", "mode": "mode"}

class Bad(Exception):
    pass

def expand(p):
    p = str(p)
    if p == "~" or p.startswith("~/"):
        return home + p[1:]
    return p

def tilde(p):
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p

def words(v):
    return " ".join(v) if isinstance(v, list) else str(v)

def check_keys(obj, allowed, where):
    if not isinstance(obj, dict):
        raise Bad("%s: expected an object" % where)
    for k in obj:
        if k not in allowed:
            raise Bad("%s: unknown key '%s' (known: %s)" % (where, k, ", ".join(sorted(allowed))))

def read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError as e:
        raise Bad("not valid JSON: %s" % e)

def write(path, d):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)

def load(path):
    d = read(path)
    check_keys(d, {"defaults", "profiles", "repos", "reposIn", "agents"}, "config")
    out = []
    call = lambda *a: out.append(" ".join(shlex.quote(str(x)) for x in a))

    defaults = d.get("defaults", {})
    check_keys(defaults, set(DEFAULTS), "defaults")
    for k, var in DEFAULTS.items():
        if k in defaults:
            v = defaults[k]
            if k in ("settings", "cloneRoot", "memories") and v:
                v = expand(v)
            out.append('[ -n "${%s+x}" ] || %s=%s' % (var, var, shlex.quote(str(v))))
    clone_root = expand(os.environ.get("YO_CLONE_ROOT")
                        or defaults.get("cloneRoot") or "~/dev/src/github.com")

    profiles = d.get("profiles", {})
    if not isinstance(profiles, dict):
        raise Bad("profiles: expected an object")
    keys, paths = set(), set()

    def repo(key, r, profile, where):
        check_keys(r, set(REPO_OPTS) | {"path"}, where)
        if "path" not in r:
            raise Bad("%s: 'path' is required" % where)
        if key in keys:
            raise Bad("%s: repo '%s' is listed twice" % (where, key))
        keys.add(key)
        p = expand(r["path"]).rstrip("/")
        paths.add(os.path.realpath(p))
        a = ["yo_repo", key, "--path=" + p]
        for jk, opt in REPO_OPTS.items():
            if jk in r:
                a.append("--%s=%s" % (opt, words(r[jk])))
        if profile:
            a.append("--profile=" + profile)
        call(*a)

    def scan(dirpath, profile, owner=None):
        # Clones directly under dirpath, keyed by directory name (owner-name
        # when the name is taken). One already listed is left as listed.
        try:
            names = sorted(os.listdir(dirpath))
        except OSError:
            return
        for n in names:
            p = os.path.join(dirpath, n)
            if not os.path.exists(os.path.join(p, ".git")):
                continue
            if os.path.realpath(p) in paths:
                continue
            key = n
            if key in keys and owner:
                key = "%s-%s" % (owner, n)
            if key in keys or not all(c.isalnum() or c in "._-" for c in key):
                continue
            keys.add(key); paths.add(os.path.realpath(p))
            a = ["yo_repo", key, "--path=" + p]
            if owner:
                a.append("--github=%s/%s" % (owner, n))
            if profile:
                a.append("--profile=" + profile)
            call(*a)

    for name, pr in profiles.items():
        where = "profiles.%s" % name
        check_keys(pr, set(PROFILE_OPTS) | {"owners", "trust", "repos", "reposIn", "agents"}, where)
        a = ["yo_profile", name]
        for jk, opt in PROFILE_OPTS.items():
            if jk in pr:
                v = pr[jk]
                a.append("--%s=%s" % (opt, expand(v) if jk in ("settings", "dir") else v))
        if pr.get("owners"):
            a.append("--owners=" + words(pr["owners"]))
        if pr.get("trust") is False:
            a.append("--trust=no")
        call(*a)

    for k, r in d.get("repos", {}).items():
        repo(k, r, "", "repos.%s" % k)
    for name, pr in profiles.items():
        for k, r in pr.get("repos", {}).items():
            repo(k, r, name, "profiles.%s.repos.%s" % (name, k))
    for dpath in d.get("reposIn", []):
        scan(expand(dpath), "")
    for name, pr in profiles.items():
        for dpath in pr.get("reposIn", []):
            scan(expand(dpath), name)
        for owner in pr.get("owners", []):
            scan(os.path.join(clone_root, owner), name, owner)

    def agent(n, ag, where):
        check_keys(ag, {"repo", "title"}, where)
        if "repo" not in ag:
            raise Bad("%s: 'repo' is required" % where)
        a = ["yo_agent", n, "--repo=" + ag["repo"]]
        if "title" in ag:
            a.append("--title=" + ag["title"])
        call(*a)
    for n, ag in d.get("agents", {}).items():
        agent(n, ag, "agents.%s" % n)
    for name, pr in profiles.items():
        for n, ag in pr.get("agents", {}).items():
            agent(n, ag, "profiles.%s.agents.%s" % (name, n))
    print("\n".join(out))

def add_repo(path, profile, key, repo_path, github):
    d = read(path)
    if profile:
        target = d.setdefault("profiles", {}).setdefault(profile, {}).setdefault("repos", {})
    else:
        target = d.setdefault("repos", {})
    entry = {"path": tilde(repo_path)}
    if github:
        entry["github"] = github
    target[key] = entry
    write(path, d)

def add_profile(path, name, owner):
    d = read(path)
    profiles = d.setdefault("profiles", {})
    if name in profiles:
        raise Bad("profile '%s' already exists" % name)
    profiles[name] = {"owners": [owner]}
    write(path, d)

try:
    if op == "load":
        load(args[0])
    elif op == "add-repo":
        add_repo(*args)
    elif op == "add-profile":
        add_profile(*args)
    else:
        raise Bad("unknown op: " + op)
except Bad as e:
    print("%s: %s" % (args[0] if args else "config", e), file=sys.stderr)
    sys.exit(1)
PY
}

# soft=1 tolerates having no repos at all (so `yo help` works anywhere).
_yo_load_config() {
  local soft="${1:-0}" cfg out
  cfg=$(_yo_config_path)
  if [ -f "$cfg" ]; then
    out=$(_yo_cfg load "$cfg") || die "failed to load config: $cfg"
    eval "$out"
    YO_CONFIG_PATH="$cfg"
  fi
  local k p
  for k in $(_yo_repo_keys); do
    p=$(_yo_field "$k" 11)
    [ -z "$p" ] || _yo_pfield "$p" 1 >/dev/null 2>&1 \
      || die "yo_repo $k: --profile=$p, but no yo_profile '$p' is defined in $cfg"
  done
  if [ -z "$_YO_REPOS" ]; then
    _yo_autoregister || {
      [ "$soft" = "1" ] && return 0
      die "no repos configured, and $(pwd) isn't inside a git clone
        add one with: yo config add-repo <clone|url>   (or cd into a clone)"
    }
  fi
}

# Defaults land AFTER the config file, so the config can set any of them.
_yo_apply_defaults() {
  BRANCH_PREFIX="${YO_BRANCH_PREFIX:-${USER:-work}}"
  CLAUDE_CMD="${YO_CLAUDE_CMD:-claude --permission-mode auto}"
  WIN_WIDTH="${YO_WIN_WIDTH:-1403}"
  WIN_HEIGHT="${YO_WIN_HEIGHT:-824}"
  YO_REVIEW_CMD_RESOLVED="${YO_REVIEW_CMD:-/code-review}"
  WORKSESH_PROFILE_NAME="${YO_ITERM_PROFILE:-worksesh}"
  YO_WINDOW_MODE_RESOLVED="${YO_WINDOW_MODE:-tab}"
  YO_WINDOW_GROUP_RESOLVED="${YO_WINDOW_GROUP:-yo}"
  case "$YO_WINDOW_MODE_RESOLVED" in
    tab|window) : ;;
    *) die "YO_WINDOW_MODE must be 'tab' or 'window' (got: '$YO_WINDOW_MODE_RESOLVED')" ;;
  esac
  YO_CLONE_ROOT_RESOLVED=$(_yo_expand_home "${YO_CLONE_ROOT:-$HOME/dev/src/github.com}")
  YO_CLONE_PROTOCOL_RESOLVED="${YO_CLONE_PROTOCOL:-ssh}"
  case "$YO_CLONE_PROTOCOL_RESOLVED" in
    ssh|https) : ;;
    *) die "YO_CLONE_PROTOCOL must be 'ssh' or 'https' (got: '$YO_CLONE_PROTOCOL_RESOLVED')" ;;
  esac
  if [ -n "${YO_ADHOC_PROFILE:-}" ]; then
    _yo_pfield "$YO_ADHOC_PROFILE" 1 >/dev/null 2>&1 \
      || die "YO_ADHOC_PROFILE: no yo_profile '$YO_ADHOC_PROFILE' is defined"
  fi
  YO_MODE_RESOLVED="${YO_MODE:-worktree}"
  case "$YO_MODE_RESOLVED" in
    here|worktree) : ;;
    *) die "YO_MODE must be 'here' or 'worktree' (got: '$YO_MODE_RESOLVED')" ;;
  esac
  YO_LAYOUT_RESOLVED="${YO_LAYOUT:-auto}"
  case "$YO_LAYOUT_RESOLVED" in
    auto|split|workgroup) : ;;
    *) die "YO_LAYOUT must be 'auto', 'split' or 'workgroup' (got: '$YO_LAYOUT_RESOLVED')" ;;
  esac
}

# --- GitHub PR / issue URL parsing -------------------------------------------
# Recognize a github.com PR or issue URL and decompose it into the pieces a
# session needs. On match, sets the globals GH_KIND (pr|issue), GH_NUMBER,
# GH_REPO_KEY (a registered repo key), and GH_URL (canonical form, with any trailing
# path/query/anchor like /files or #issuecomment stripped). Returns non-zero if
# the string isn't a PR/issue URL.
parse_github_url() {
  local url="$1"
  [[ "$url" =~ github\.com/([^/]+)/([^/]+)/(pull|issues)/([0-9]+) ]] || return 1
  local owner="${BASH_REMATCH[1]}" repo="${BASH_REMATCH[2]}"
  local seg="${BASH_REMATCH[3]}" num="${BASH_REMATCH[4]}"
  # An unregistered repo leaves GH_REPO_KEY empty: fine for a session in place
  # (nothing is checked out), fatal for a worktree — cmd_up decides.
  GH_REPO_KEY=$(repo_key_from_url "$url") || GH_REPO_KEY=""
  GH_NUMBER="$num"
  GH_OWNER_REPO="${owner}/${repo}"
  GH_URL="https://github.com/${owner}/${repo}/${seg}/${num}"
  case "$seg" in
    pull)   GH_KIND="pr" ;;
    issues) GH_KIND="issue" ;;
  esac
}

# A PR/issue URL for a repo that isn't registered: register it for this run,
# cloning it first if it isn't already at <YO_CLONE_ROOT>/<owner>/<repo>. With a
# profile it joins that profile; without, it's a guest (YO_GUEST_REPO). Sets
# YO_URL_REPO to its key either way. Runs in the caller's shell, not a $(...),
# because the registration has to outlive it.
register_url_repo() {
  local owner_repo="$1" profile="${2:-}" owner repo path key url
  owner="${owner_repo%%/*}"; repo="${owner_repo#*/}"
  # These become a path and a clone URL, so nothing but what GitHub allows.
  case "$owner$repo" in
    *[!A-Za-z0-9._-]*|.*) die "can't use '$owner_repo': unexpected characters in the repo name" ;;
  esac
  path="$YO_CLONE_ROOT_RESOLVED/$owner/$repo"
  if [ -e "$path" ]; then
    [ -e "$path/.git" ] || die "can't use $owner_repo: $path exists and isn't a git clone"
    echo "==> using the clone of $owner_repo at $path"
  else
    case "$YO_CLONE_PROTOCOL_RESOLVED" in
      ssh)   url="git@github.com:${owner_repo}.git" ;;
      https) url="https://github.com/${owner_repo}.git" ;;
    esac
    echo "==> cloning $owner_repo to $path"
    mkdir -p "$(dirname "$path")"
    git clone "$url" "$path" || die "couldn't clone $url
        (YO_CLONE_PROTOCOL picks ssh or https; YO_CLONE_ROOT picks where clones go)"
  fi
  key="$repo"
  _yo_field "$key" 1 >/dev/null 2>&1 && key="$owner-$repo"
  YO_URL_REPO="$key"
  if [ -n "$profile" ]; then
    yo_repo "$key" --path="$path" --github="$owner_repo" --profile="$profile"
    return 0
  fi
  if [ -n "${YO_ADHOC_PROFILE:-}" ]; then
    yo_repo "$key" --path="$path" --github="$owner_repo" --mode=worktree \
      --profile="$YO_ADHOC_PROFILE"
  else
    yo_repo "$key" --path="$path" --github="$owner_repo" --mode=worktree --memory=none
  fi
  YO_GUEST_REPO="$key"
}

# Where a URL's unregistered repo goes, then registers it there (see
# register_url_repo): the profile that claims its owner; else what --add-to
# said (a profile, or `guest`); else, at a terminal, whatever you pick; else a
# guest. A pick of a profile is saved to the config, so it is asked only once.
place_url_repo() {
  local owner_repo="$1" add_to="${2:-}" owner profile cfg choice
  owner="${owner_repo%%/*}"
  if profile=$(_yo_profile_for_owner "$owner"); then
    echo "==> $owner_repo belongs to profile '$profile' (it claims $owner)"
    register_url_repo "$owner_repo" "$profile"
    return 0
  fi
  cfg=$(_yo_config_path)
  if [ -z "$add_to" ] && [ -t 0 ] && [ -t 1 ] && [ -z "${CLAUDECODE:-}" ] \
      && [ -f "$cfg" ]; then
    add_to=$(_yo_ask_placement "$owner_repo") || add_to="guest"
  fi
  case "$add_to" in
    ""|guest)
      register_url_repo "$owner_repo" ;;
    +*)
      # A new profile named after the owner, claiming all of it.
      profile="${add_to#+}"
      _yo_cfg add-profile "$cfg" "$profile" "$owner" || die "couldn't add profile '$profile' to $cfg"
      yo_profile "$profile" --owners="$owner"
      echo "==> new profile '$profile' (claims every $owner/* repo), saved to $cfg"
      register_url_repo "$owner_repo" "$profile" ;;
    *)
      _yo_pfield "$add_to" 1 >/dev/null 2>&1 \
        || die "--add-to must be a profile ($(_yo_profile_names | paste -sd' ' -)) or guest (got: '$add_to')"
      register_url_repo "$owner_repo" "$add_to"
      if [ -f "$cfg" ]; then
        _yo_cfg add-repo "$cfg" "$add_to" "$YO_URL_REPO" "$(repo_path_for "$YO_URL_REPO")" "$owner_repo" \
          && echo "==> added $owner_repo to profile '$add_to' in $cfg" \
          || echo "yo: couldn't save $owner_repo to $cfg; it's in '$add_to' for this run only"
      else
        echo "yo: no config at $cfg, so $owner_repo is in '$add_to' for this run only"
      fi ;;
  esac
}

# Asks where an unconfigured repo goes; echoes a profile name, "+<name>" for a
# new profile, or "guest". The menu goes to the terminal, not to the caller.
_yo_ask_placement() {
  local owner_repo="$1" owner n i=0 names="" ans new=""
  owner="${owner_repo%%/*}"
  {
    echo "$owner_repo isn't configured. Where does it go?"
    for n in $(_yo_profile_names); do
      i=$((i + 1)); names="$names $n"
      printf '  [%d] add it to profile %s\n' "$i" "$n"
    done
    if ! _yo_pfield "$owner" 1 >/dev/null 2>&1 \
        && ! _yo_field "$owner" 1 >/dev/null 2>&1 \
        && case "$owner" in *[!A-Za-z0-9._-]*) false ;; *) true ;; esac; then
      new="$owner"
      printf '  [n] a new profile "%s" that claims every %s/* repo\n' "$owner" "$owner"
    fi
    echo "  [g] just this once, as a guest (no shared memory, not pre-trusted)"
    printf 'choice [g]: '
  } >/dev/tty
  read -r ans </dev/tty || ans=""
  case "$ans" in
    ""|g|G) echo guest ;;
    n|N)    if [ -n "$new" ]; then echo "+$new"; else echo guest; fi ;;
    *[!0-9]*) echo guest ;;
    *)      set -- $names
            if [ "$ans" -ge 1 ] && [ "$ans" -le "$#" ]; then
              eval "echo \${$ans}"
            else
              echo guest
            fi ;;
  esac
}

die_unknown_url_repo() {
  local unresolved hint=""
  unresolved=$(_yo_unresolved_repos)
  [ -n "$unresolved" ] && hint="
        couldn't work out owner/repo for: $unresolved
        (clone missing? or give it an explicit --github=owner/repo)"
  die "unrecognized repo in URL: $1
        known repos: $(_yo_repo_list)${hint}
        register it: yo config add-repo <clone|url>"
}

# --- iTerm2 title lock (dynamic profile) --------------------------------------
# The window/tab title follows the active pane, and claude UNCONDITIONALLY sets
# the terminal title to "Claude Code (...)" — there's no flag/setting to stop it
# (feature request declined upstream), so it clobbers any title we set with an
# OSC escape. iTerm2's window.name and tab.title aren't settable via AppleScript
# either (-10000 / -10006).
#
# The one thing that works: an iTerm2 *dynamic profile* with "Allow Title
# Setting" = false, which makes iTerm IGNORE any app's attempt to set the title
# (claude included). With that lock on, `set name of session` via AppleScript
# sticks and can't be overwritten. We build that profile as a full copy of the
# user's Default profile (so colors/font match exactly) plus the two overrides,
# and regenerate it whenever Default changes. Title Components=1 => the title is
# just the session name, no "(job)" suffix.
# (the profile name itself is configurable — YO_ITERM_PROFILE.)

# Writes/updates ~/…/DynamicProfiles/<name>.json. Echoes "WROTE" when the file
# changed (caller then lets iTerm reload it). Exit 2 => couldn't read the
# Default profile; caller falls back to the plain default profile (no lock).
ensure_iterm_profile() {
  python3 - "$WORKSESH_PROFILE_NAME" <<'PY'
import subprocess, plistlib, os, json, sys
name = sys.argv[1]
prefs = os.path.expanduser("~/Library/Preferences/com.googlecode.iterm2.plist")
dpdir = os.path.expanduser("~/Library/Application Support/iTerm2/DynamicProfiles")
out = os.path.join(dpdir, name + ".json")
try:
    xml = subprocess.run(["plutil", "-convert", "xml1", "-o", "-", prefs],
                         capture_output=True, check=True).stdout
    d = plistlib.loads(xml)
    default = next(b for b in d["New Bookmarks"] if b.get("Name") == "Default")
except Exception:
    sys.exit(2)
def json_safe(v):
    try:
        json.dumps(v); return True
    except (TypeError, ValueError):
        return False
prof = {k: v for k, v in default.items() if json_safe(v)}  # drop any binary keys
prof["Name"] = name
prof["Guid"] = name + "-dynamic-profile"
prof["Allow Title Setting"] = False   # iTerm ignores app title escapes (claude)
prof["Title Components"] = 1           # title = session name only
# The Claude Code workgroup renames the main session to "Chat" on entry, so
# with every session in one window the tab bar would read Chat, Chat, Chat.
# Pin the TAB title to a user variable instead: yo sets user.yoTitle per
# session and nothing else touches it.
prof["Use Custom Tab Title"] = True
prof["Custom Tab Title"] = "\\(currentSession.user.yoTitle)"
content = json.dumps({"Profiles": [prof]}, sort_keys=True, indent=2)
os.makedirs(dpdir, exist_ok=True)
old = open(out).read() if os.path.exists(out) else None
if old == content:
    print("UNCHANGED")
else:
    tmp = out + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.replace(tmp, out)
    print("WROTE")
PY
}

# Does iTerm2's Claude Code workgroup have a peer session (a terminal living
# alongside the chat, e.g. "CLI")? That peer is the shell, so yo needn't split
# a pane for one. The workgroups are a JSON blob in iTerm's preferences.
# Exit 0 => yes.
iterm_workgroup_has_peer() {
  python3 - <<'PY'
import subprocess, plistlib, os, json, sys
prefs = os.path.expanduser("~/Library/Preferences/com.googlecode.iterm2.plist")
try:
    xml = subprocess.run(["plutil", "-convert", "xml1", "-o", "-", prefs],
                         capture_output=True, check=True).stdout
    groups = json.loads(plistlib.loads(xml)["Workgroups"])
except Exception:
    sys.exit(1)
for g in groups:
    if g.get("uniqueIdentifier") != "builtin.claudeCode":
        continue
    for s in g.get("sessions", []):
        if (s.get("kind") or {}).get("kind") == "peer":
            sys.exit(0)
sys.exit(1)
PY
}

# Primary display's pixel size, echoed as "W H". Uses JXA's built-in ObjC bridge
# (available on every modern macOS — unlike pyobjc, which system python3 lacks) to
# read NSScreen.screens[0], i.e. the display with the menu bar, whose top-left is
# global (0,0). Echoes nothing on failure; the caller then falls back to Finder's
# desktop bounds. NOTE: this is deliberately NOT the Finder desktop bounds, which
# are the UNION across all displays — centering in that union is what pushed the
# window off toward a second monitor.
primary_screen_size() {
  /usr/bin/osascript -l JavaScript -e 'ObjC.import("AppKit"); var s=$.NSScreen.screens.objectAtIndex(0).frame.size; Math.round(s.width) + " " + Math.round(s.height)' 2>/dev/null || true
}

# --- iTerm2 automation --------------------------------------------------------
# Sessions land as TABS in one shared window, so iTerm2's Session Status tool
# (which only ever lists the sessions of a single window) becomes a dashboard of
# every session instead of one row per window. Under the `split` layout each
# tab is split side-by-side: claude on the left, a shell in the worktree on the
# right. Under `workgroup` the tab is claude alone — the workgroup's terminal
# peer is the shell.
#
# Finding that window again: every session yo creates carries the user variable
# `user.yoWindow`, set to the window group. To place a new tab we look for any
# session anywhere carrying our group and use its window. No state file, and it
# self-heals — close the window and the next `yo` just opens a fresh one. Window
# ids are not durable across an iTerm restart, which is why we don't store one.
#
# Shell commands are pre-quoted and passed to AppleScript as argv so we don't
# fight AppleScript's string quoting.
open_iterm_session() {
  local wt_path="$1" win_title="$2" claude_cmd="$3" profile="$4"
  local marker="$5" force_new="$6" do_split="$7"
  local q_path setup_cmd
  q_path=$(printf '%q' "$wt_path")
  setup_cmd="cd ${q_path}"

  # Primary-display size for centering a NEW window (falls back to the Finder
  # union in-script if empty). Split "W H" into two args for AppleScript.
  local scr scrW=0 scrH=0
  scr=$(primary_screen_size)
  if [ -n "$scr" ]; then
    scrW=${scr% *}; scrH=${scr#* }
  fi

  /usr/bin/osascript - "$win_title" "$profile" "$setup_cmd" "$claude_cmd" \
    "$WIN_WIDTH" "$WIN_HEIGHT" "$scrW" "$scrH" "$marker" "$force_new" \
    "$do_split" <<'APPLESCRIPT'
on run argv
  set winTitle to item 1 of argv
  set profileName to item 2 of argv
  set setupCmd to item 3 of argv
  set claudeCmd to item 4 of argv
  set winW to (item 5 of argv) as integer
  set winH to (item 6 of argv) as integer
  set scrW to (item 7 of argv) as integer
  set scrH to (item 8 of argv) as integer
  set marker to item 9 of argv
  set forceNew to (item 10 of argv) as integer
  set doSplit to (item 11 of argv) as integer

  tell application "iTerm2"
    activate
    set targetWin to missing value

    -- Reuse the window already holding this group's sessions, if there is one.
    if forceNew is 0 then
      repeat with ww in windows
        repeat with tt in tabs of ww
          repeat with ss in sessions of tt
            set v to ""
            try
              tell ss
                set v to variable named "user.yoWindow"
              end tell
            end try
            if v is marker then set targetWin to ww
          end repeat
        end repeat
      end repeat
    end if

    if targetWin is missing value then
      -- New window, centered on the PRIMARY display (its top-left is global
      -- (0,0), so half the leftover space is the top-left corner). If we
      -- couldn't read the screen size, fall back to Finder's desktop bounds —
      -- but that's the UNION across all displays, so on a multi-monitor setup
      -- the window lands off to the right (the old bug).
      if profileName is "" then
        set targetWin to (create window with default profile)
      else
        set targetWin to (create window with profile profileName)
      end if
      if scrW is 0 or scrH is 0 then
        tell application "Finder" to set sb to bounds of window of desktop
        set scrW to item 3 of sb
        set scrH to item 4 of sb
      end if
      set x1 to (scrW - winW) div 2
      set y1 to (scrH - winH) div 2
      set bounds of targetWin to {x1, y1, x1 + winW, y1 + winH}
      set leftSession to (current session of targetWin)
    else
      -- Existing window: add a tab and leave the window's size/position alone.
      try
        set frontmost of targetWin to true
      end try
      tell targetWin
        if profileName is "" then
          set newTab to (create tab with default profile)
        else
          set newTab to (create tab with profile profileName)
        end if
      end tell
      set leftSession to (current session of newTab)
    end if

    -- Name the panes; with the profile's title lock this sticks and claude
    -- (left pane) can't overwrite it. The TAB title follows the active
    -- session's name, so this is what labels the tab and the Session Status row.
    --
    -- Marker: how the next `yo` finds this window. yoTitle drives the tab
    -- title (see the profile's Custom Tab Title) and survives the workgroup
    -- renaming the session.
    tell leftSession
      write text setupCmd
      set name to winTitle
      set variable named "user.yoWindow" to marker
      set variable named "user.yoTitle" to winTitle
    end tell

    if doSplit is 1 then
      tell leftSession
        if profileName is "" then
          set rightSession to (split vertically with default profile)
        else
          set rightSession to (split vertically with profile profileName)
        end if
      end tell
      tell rightSession
        write text setupCmd
        set name to winTitle
        set variable named "user.yoWindow" to marker
        set variable named "user.yoTitle" to winTitle
      end tell
    end if

    tell leftSession
      write text claudeCmd
      select
    end tell
  end tell
end run
APPLESCRIPT
}

# The Claude Code workgroup integration renames the main session to the
# workgroup session's name ("Chat") a moment after claude starts. The tab title
# is already immune (pinned to user.yoTitle by the profile), but Session Status
# rows are labelled with the session NAME — so a window full of yo sessions
# would show a column of identical "Chat" rows. Put the name back once the
# rename has happened. Detached, so yo doesn't block waiting for it; harmless
# when the integration isn't installed and no rename ever comes.
reassert_session_title() {
  local title="$1"
  ( /usr/bin/osascript - "$title" <<'APPLESCRIPT'
on run argv
  set want to item 1 of argv
  -- Poll rather than sleep-once: the rename lands whenever claude first prints
  -- enough for the trigger to fire, and a workgroup can be re-entered later.
  repeat 12 times
    delay 2
    tell application "iTerm2"
      repeat with ww in windows
        repeat with tt in tabs of ww
          repeat with ss in sessions of tt
            set v to ""
            try
              tell ss
                set v to variable named "user.yoTitle"
              end tell
            end try
            if v is want and (name of ss) is not want then set name of ss to want
          end repeat
        end repeat
      end repeat
    end tell
  end repeat
end run
APPLESCRIPT
  ) >/dev/null 2>&1 &
  disown >/dev/null 2>&1 || true
}

# --- trust seeding ------------------------------------------------------------
# Claude Code has no parent-folder trust: trust is a per-exact-path record in
# ~/.claude.json (projects["<path>"].hasTrustDialogAccepted). Since we just
# created the worktree, seed that record so the "trust this folder?" dialog
# never appears, and mirror the base clone's external-include approval.
# (MCP-server approval is NOT here — it lives in .claude/settings.local.json;
# see mirror_local_settings below.)
# Best-effort: on any failure we just let Claude show the dialog as usual.
# Caveat: this read-modify-writes ~/.claude.json; other running Claude sessions
# also write it, so there's a small last-writer-wins window (atomic rename keeps
# the file from ever being partial).
seed_trust() {
  local wt_path="$1" base_path="$2"
  CLAUDE_JSON="$HOME/.claude.json" python3 - "$wt_path" "$base_path" <<'PY'
import json, os, sys, tempfile
wt, base = sys.argv[1], sys.argv[2]
path = os.environ["CLAUDE_JSON"]
try:
    with open(path) as f:
        d = json.load(f)
except FileNotFoundError:
    d = {}
projects = d.setdefault("projects", {})
base_ent = projects.get(base, {})
ent = projects.get(wt, {})
# mirror the base clone's external-include approval so we don't add a new prompt
for k in ("hasClaudeMdExternalIncludesApproved",
          "hasClaudeMdExternalIncludesWarningShown"):
    if k in base_ent and k not in ent:
        ent[k] = base_ent[k]
ent["hasTrustDialogAccepted"] = True
projects[wt] = ent
d_dir = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d_dir)
try:
    with os.fdopen(fd, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, path)
except Exception:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
}

# --- mirror local Claude settings ---------------------------------------------
# .claude/settings.local.json (gitignored) is where project MCP-server approvals
# live (enableAllProjectMcpServers / enabledMcpjsonServers). It's honored even in
# an untrusted folder, but because it's gitignored it isn't in the fresh
# worktree checkout — so copy it from the base clone AND union in the per-repo
# allow-list below, so a stale/absent base file can't reintroduce the prompt.

# (mcp_servers_for lives in the repo registry above, fed by --mcp.)

mirror_local_settings() {
  local wt_path="$1" base_path="$2" repo_key="$3"
  local rel=".claude/settings.local.json"
  mkdir -p "$wt_path/.claude"
  [ -f "$base_path/$rel" ] && cp "$base_path/$rel" "$wt_path/$rel" 2>/dev/null
  if MCP_SERVERS="$(mcp_servers_for "$repo_key")" python3 - "$wt_path/$rel" <<'PY_EOF'
import json, os, sys
path = sys.argv[1]
want = os.environ.get("MCP_SERVERS", "").split()
try:
    with open(path) as f:
        d = json.load(f)
except (FileNotFoundError, ValueError):
    d = {}
have = d.get("enabledMcpjsonServers") or []
merged = have + [w for w in want if w not in have]
if merged != have:
    d["enabledMcpjsonServers"] = merged
    with open(path, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
PY_EOF
  then
    echo "==> settings.local.json in place (MCP approvals: base clone + per-repo allow-list)"
  else
    echo "yo: couldn't write $rel (Claude may prompt for MCP servers)"
  fi
}

# Gitignored, machine-local files a worktree needs a copy of (--mirror). A repo's
# MCP launchers typically read their token out of `.env` at the REPO ROOT, which
# in a worktree is the worktree -- so the main clone's .env is invisible there,
# and a launcher with no fallback exits with "<VAR> is not set", which Claude
# reports as a connection failure rather than a missing credential.
# (mirrored_repo_files_for lives in the repo registry above, fed by --mirror.)

mirror_repo_files() {
  local wt_path="$1" base_path="$2" repo_key="$3" rel
  for rel in $(mirrored_repo_files_for "$repo_key"); do
    if [ ! -f "$base_path/$rel" ]; then
      echo "yo: no $rel in $base_path -- skipped (servers that read it won't start)"
      continue
    fi
    if [ -e "$wt_path/$rel" ]; then
      echo "==> $rel already in the worktree; left alone"
      continue
    fi
    # These hold credentials, so refuse to place one where a `git add -A` could
    # stage it. Checked against the WORKTREE's ignore rules, not the clone's.
    if ! git -C "$wt_path" check-ignore -q "$rel"; then
      echo "yo: $rel is NOT gitignored in $repo_key -- not copying (it could be committed)"
      continue
    fi
    # -p keeps the source's mode: widening or narrowing a secrets file's
    # permissions behind your back would diverge from the main checkout.
    if cp -p "$base_path/$rel" "$wt_path/$rel" 2>/dev/null; then
      echo "==> $rel copied from the main clone (gitignored; goes away with the worktree)"
    else
      echo "yo: couldn't copy $rel into the worktree"
    fi
  done
}

# --- session ledger -----------------------------------------------------------
# Claude Code's own registry of running sessions (~/.claude/sessions/<pid>.json)
# can't survive a crash or restart: the first claude started afterwards prunes
# every entry whose pid is dead. Transcripts (~/.claude/projects/) DO survive, so
# all `claude --resume` needs is the session id and the directory — which is
# what this ledger keeps, one JSON file per session, along with what it takes to
# launch the session the same way again (repo, profile, mode, title).
#
# A worktree holds one session, so its record is keyed by the worktree. An
# in-place session's directory may hold several at once, so its record is keyed
# by the id it started with ("id-<sid>"); the key never changes after that.
#
# Ids enter the ledger three ways:
#   - yo mints the id up front (`claude --session-id`) when it creates a session;
#   - a SessionStart hook, carried in the session's settings layer, records the
#     new id when one changes it (/clear). Its SessionEnd twin marks a
#     deliberate quit, so resume-all doesn't bring back sessions you meant to
#     end. yo launches claude with
#     YO_SESSION_KEY set, so the hook knows which record is its own; without it
#     (a session yo didn't launch) the hook goes by the worktree it runs in;
#   - `sync` adopts whatever is running right now in a yo worktree, which covers
#     sessions started some other way (by hand, or before yo kept a ledger).

# Every op is best-effort JSON wrangling, so it all lives in one python3 helper.
#   put DIR SID TITLE REPO NAME PROFILE MODE GUEST [AGENT [HOME [RC]]]
#                                create/replace a record; prints its key.
#                                HOME=1 marks an agent's home; RC is its
#                                Remote Control name
#   hook                         SessionStart/SessionEnd payload in
#                                $YO_HOOK_INPUT; never fails
#   drop KEY                     forget one record
#   adopt DIR SID TITLE TITLE_GIVEN REPO NAME PROFILE MODE
#                                record a session from inside it (yo adopt)
#   launch-cwd SID               the directory that session was launched in
#   drop-dir WT                  forget a worktree's record
#   retitle KEY SID CWD TITLE    set the title on record KEY, else the one
#                                holding SID, else CWD's yo worktree's
#   sync                         adopt live sessions in yo worktrees (YO_CLONES)
#   list                         TSV, one row per record (see row())
#   sweep [flags]                classify and (with --apply) remove landed
#                                worktrees; repos in YO_SWEEP_REPOS (cmd_sweep)
#   home DIR                     the session `yo NAME` reaches in home repo DIR
#   reach QUERY                  what `yo QUERY` reaches: a live session by its
#                                Claude name, else a ledger row (see cmd_reach)
#   get QUERY                    the same TSV row for one session, matched by
#                                id (or 8+ char prefix), directory, or name;
#                                an id the ledger lacks is found by transcript
# status: running (pid set) | ready | ended (quit with /exit; resumable by
#         name, skipped by resume-all) | gone (directory removed) | no-id
_yo_state() {
  YO_STATE_DIR="$YO_STATE_DIR" python3 - "$@" <<'PY'
import glob, json, os, subprocess, sys, time

home = os.path.expanduser("~")
state = os.environ["YO_STATE_DIR"]
op, args = sys.argv[1], sys.argv[2:]

def wt_key(wt):
    rel = os.path.relpath(wt, home) if wt.startswith(home + "/") else wt.lstrip("/")
    return rel.replace("/", "__")

def load_all():
    out = []
    for f in sorted(glob.glob(os.path.join(state, "*.json"))):
        try:
            with open(f) as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            continue
        rec["_key"] = os.path.basename(f)[:-len(".json")]
        out.append(rec)
    return out

def write(rec):
    # The file a record was loaded from is where it goes back to, even when
    # its sessionId has changed since.
    key = rec.pop("_key")
    rec["updatedAt"] = int(time.time())
    os.makedirs(state, exist_ok=True)
    p = os.path.join(state, key + ".json")
    tmp = p + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(rec, fh, indent=2, sort_keys=True)
    os.replace(tmp, p)
    rec["_key"] = key

def live_sessions():
    # Interactive claude processes that are actually alive. A pid can be reused
    # after a reboot, so the process must also still be claude.
    out = []
    for f in glob.glob(os.path.join(home, ".claude", "sessions", "*.json")):
        try:
            with open(f) as fh:
                d = json.load(fh)
            pid = int(d["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if d.get("kind", "interactive") != "interactive" or not d.get("sessionId"):
            continue
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        except PermissionError:
            pass
        comm = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)],
                              capture_output=True, text=True).stdout
        if "claude" in comm:
            out.append(d)
    return out

def owns(wt, cwd):
    return cwd == wt or cwd.startswith(wt.rstrip("/") + "/")

def status_of(rec, live):
    for d in live:
        if d.get("sessionId") == rec.get("sessionId"):
            return "running", str(d["pid"])
    if not os.path.isdir(rec["worktree"]):
        return "gone", ""
    if not rec.get("sessionId"):
        return "no-id", ""
    if rec.get("endedAt"):
        return "ended", ""
    return "ready", ""

def row(rec, live):
    st, pid = status_of(rec, live)
    mode = rec.get("mode") or ("here" if rec.get("byId") else "worktree")
    # "-" for empty: bash's `read` collapses runs of tabs, which would shift
    # every field after an empty one.
    fields = [st, pid, rec.get("name"), rec.get("repo"), rec.get("sessionId"),
              rec["worktree"], rec.get("title") or rec.get("name"),
              rec.get("_key"), rec.get("profile"), mode, rec.get("guest"),
              rec.get("agent"), "home" if rec.get("home") else "",
              rec.get("remoteControl")]
    print("\t".join(f or "-" for f in fields))

if op == "put":
    d, sid, title, repo, name, profile, mode, guest = args[:8]
    agent, is_home, rc = (args[8:] + ["", "", ""])[:3]
    rec = {"worktree": d, "sessionId": sid, "title": title, "repo": repo,
           "name": name, "profile": profile, "mode": mode,
           "createdAt": int(time.time())}
    if guest:
        rec["guest"] = guest
    if agent:
        rec["agent"] = agent
    if is_home == "1":
        rec["home"] = True
    if rc:
        rec["remoteControl"] = rc
    if mode == "here":
        rec["byId"] = True
        rec["_key"] = "id-" + sid
    else:
        rec["_key"] = wt_key(d)
    rec = {k: v for k, v in rec.items() if v != ""}
    write(rec)
    print(rec["_key"])

elif op == "hook":
    try:
        d = json.loads(os.environ.get("YO_HOOK_INPUT") or "{}")
        cwd, sid = d.get("cwd", ""), d.get("session_id", "")
        key = os.environ.get("YO_SESSION_KEY", "")
        event = d.get("hook_event_name", "SessionStart")
        for rec in load_all() if sid else []:
            if key:
                if rec["_key"] != key:
                    continue
            elif not owns(rec["worktree"], cwd) \
                    or (rec.get("byId") and rec.get("sessionId") != sid):
                continue
            if event == "SessionEnd":
                # Only a deliberate quit (/exit, ctrl-d) ends a session for
                # good. A closed tab or terminal reports "other", and a crash
                # reports nothing: both stay resumable, which is the point.
                if d.get("reason") == "prompt_input_exit" and rec.get("sessionId") == sid:
                    rec["endedAt"] = int(time.time())
                    write(rec)
            else:
                changed = rec.get("sessionId") != sid
                rec["sessionId"] = sid
                if rec.pop("endedAt", None) is not None:
                    changed = True   # resumed after a deliberate exit
                if changed:
                    write(rec)
    except Exception:
        pass   # a ledger hiccup must never get in the way of claude

elif op == "adopt":
    # adopt DIR SID TITLE TITLE_GIVEN REPO NAME PROFILE MODE: record a session
    # from inside it. One the ledger already holds (even under an older id's
    # key, after a /clear) keeps its record; a worktree's record keeps what yo
    # wrote at create time.
    d, sid, title, title_given, repo, name, profile, mode = args
    recs = load_all()
    held = [r for r in recs if r.get("sessionId") == sid]
    if held:
        rec = held[0]
        if title_given == "1":
            rec["title"] = title
    else:
        key = "id-" + sid if mode == "here" else wt_key(d)
        rec = {"worktree": d, "sessionId": sid, "title": title, "repo": repo,
               "name": name, "profile": profile, "mode": mode,
               "createdAt": int(time.time()), "_key": key}
        if mode == "here":
            rec["byId"] = True
        for old in recs:
            if old["_key"] == key:
                # what yo recorded at create time, including the agent it
                # runs as and whether it is an agent's home
                for k in ("createdAt", "profile", "guest", "agent", "home",
                          "remoteControl") + \
                        (("title",) if title_given != "1" else ()):
                    if old.get(k):
                        rec[k] = old[k]
        rec = {k: v for k, v in rec.items() if v != ""}
    rec.pop("endedAt", None)
    write(rec)
    print(rec["_key"])

elif op == "launch-cwd":
    # The directory a session was launched in: what `claude --resume` needs to
    # be run from. The live registry knows it; the transcript's first entry is
    # the fallback.
    sid = args[0]
    for f in glob.glob(os.path.join(home, ".claude", "sessions", "*.json")):
        try:
            with open(f) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("sessionId") == sid and d.get("cwd"):
            print(d["cwd"])
            sys.exit(0)
    for t in glob.glob(os.path.join(home, ".claude", "projects", "*", sid + ".jsonl")):
        with open(t) as fh:
            for line in fh:
                try:
                    cwd = json.loads(line).get("cwd")
                except ValueError:
                    continue
                if cwd:
                    print(cwd)
                    sys.exit(0)
    sys.exit(1)

elif op == "retitle":
    # retitle KEY SID CWD TITLE: claude runs with YO_SESSION_KEY, so a session
    # yo launched names its record outright; one it didn't goes by its id, and
    # a plain shell (neither) by the yo worktree it stands in.
    key, sid, cwd, title = args
    recs = load_all()
    hit = [r for r in recs if key and r["_key"] == key]
    if not hit:
        hit = [r for r in recs if sid and r.get("sessionId") == sid]
    if not hit:
        hit = [r for r in recs if not r.get("byId") and owns(r["worktree"], cwd)]
    for rec in hit:
        rec["title"] = title
        write(rec)
    sys.exit(0 if hit else 1)

elif op in ("drop", "drop-dir"):
    key = args[0] if op == "drop" else wt_key(args[0])
    try:
        os.unlink(os.path.join(state, key + ".json"))
    except FileNotFoundError:
        sys.exit(1)

elif op == "sync":
    # YO_CLONES: one "clone-path<TAB>repo-key<TAB>title-prefix<TAB>profile"
    # line per repo.
    clones = {}
    for line in os.environ.get("YO_CLONES", "").splitlines():
        parts = line.split("\t")
        if len(parts) == 4:
            clones[parts[0].rstrip("/")] = (parts[1], parts[2], parts[3])
    recs = {r["_key"]: r for r in load_all()}
    for d in sorted(live_sessions(), key=lambda d: d.get("updatedAt", 0)):
        cwd = d.get("cwd", "")
        for clone, (key, prefix, profile) in clones.items():
            root = clone + "-worktrees/"
            if not cwd.startswith(root):
                continue
            name = cwd[len(root):].split("/", 1)[0]
            wt = root + name
            if not os.path.exists(os.path.join(wt, ".git")):
                continue
            rec = recs.get(wt_key(wt))
            if rec is None:
                rec = {"worktree": wt, "repo": key, "name": name,
                       "title": prefix + name, "mode": "worktree",
                       "createdAt": int(time.time()), "_key": wt_key(wt)}
                if profile:
                    rec["profile"] = profile
            if rec.get("sessionId") != d["sessionId"] or rec.get("endedAt"):
                rec["sessionId"] = d["sessionId"]
                rec.pop("endedAt", None)
                write(rec)
                recs[rec["_key"]] = rec
                print("adopted %s (%s) from a live session" % (name, d["sessionId"]),
                      file=sys.stderr)

elif op == "list":
    live = live_sessions()
    for rec in load_all():
        row(rec, live)

elif op == "get":
    q = args[0].rstrip("/") or "/"
    live = live_sessions()
    recs = load_all()
    hits = [r for r in recs if r.get("sessionId") == q or r["worktree"] == q]
    if not hits and len(q) >= 8:
        hits = [r for r in recs if (r.get("sessionId") or "").startswith(q)]
    if not hits:
        hits = [r for r in recs if r.get("name") == q]
    if not hits:
        # Not in the ledger: an id from anywhere (`claude --resume`'s picker, an
        # old window) is still resumable if its transcript records a cwd.
        for t in glob.glob(os.path.join(home, ".claude", "projects", "*", q + ".jsonl")):
            with open(t) as fh:
                for line in fh:
                    try:
                        cwd = json.loads(line).get("cwd")
                    except ValueError:
                        continue
                    if cwd:
                        hits = [{"worktree": cwd, "name": os.path.basename(cwd),
                                 "sessionId": q, "transcriptOnly": True}]
                        break
            if hits:
                break
    if len(hits) > 1:
        print("ambiguous: %d sessions match '%s'" % (len(hits), q), file=sys.stderr)
        for r in hits:
            row(r, live)
        sys.exit(2)
    if not hits:
        sys.exit(1)
    row(hits[0], live)
    if hits[0].get("transcriptOnly"):
        print("transcript-only", file=sys.stderr)

elif op == "home":
    # home DIR: the session to reach in a home repo's clone. One running there
    # (from the ledger, else any live claude whose cwd is DIR), else the most
    # recently used ready one. A session quit with /exit is left alone, so the
    # next `yo NAME` starts fresh. Same output as reach; exit 1: none.
    d = os.path.realpath(args[0])
    live = live_sessions()
    recs = [r for r in load_all() if os.path.realpath(r["worktree"]) == d]
    recs.sort(key=lambda r: r.get("updatedAt") or r.get("createdAt") or 0, reverse=True)
    running = [r for r in recs if status_of(r, live)[0] == "running"]
    if running:
        sys.stdout.write("ledger\t")
        row(running[0], live)
        sys.exit(0)
    here = [x for x in live if os.path.realpath(x.get("cwd") or "/") == d]
    if here:
        x = max(here, key=lambda x: x.get("updatedAt", 0))
        print("\t".join(["live", str(x["pid"]), x.get("sessionId", "-"), x.get("name") or "-"]))
        sys.exit(0)
    ready = [r for r in recs if status_of(r, live)[0] == "ready"]
    if ready:
        sys.stdout.write("ledger\t")
        row(ready[0], live)
        sys.exit(0)
    sys.exit(1)

elif op == "reach":
    # reach Q: what `yo Q` should reach. A live session by its Claude name
    # first ("live<TAB>pid<TAB>sessionId<TAB>name"), then a ledger session by
    # yo name, id or id prefix ("ledger<TAB>" + row). Exit 1: nothing; 2: ambiguous.
    q = args[0]
    live = live_sessions()
    named = [d for d in live if d.get("name") == q]
    if len(named) > 1:
        print("ambiguous: %d live sessions are named '%s'" % (len(named), q), file=sys.stderr)
        sys.exit(2)
    if named:
        d = named[0]
        print("\t".join(["live", str(d["pid"]), d.get("sessionId", "-"), q]))
        sys.exit(0)
    recs = load_all()
    hits = [r for r in recs if r.get("sessionId") == q or r.get("name") == q]
    if not hits and len(q) >= 8:
        hits = [r for r in recs if (r.get("sessionId") or "").startswith(q)]
    if len(hits) > 1:
        print("ambiguous: %d sessions match '%s'" % (len(hits), q), file=sys.stderr)
        for r in hits:
            row(r, live)
        sys.exit(2)
    if not hits:
        sys.exit(1)
    st, _ = status_of(hits[0], live)
    if st not in ("running", "ready", "ended"):
        sys.exit(1)   # gone or no id: nothing to reach, so `yo Q` creates as before
    sys.stdout.write("ledger\t")
    row(hits[0], live)

elif op == "sweep":
    # Worktrees whose work has landed, minus any a session still needs.
    # YO_SWEEP_REPOS: one "key<TAB>clone<TAB>base<TAB>owner/repo<TAB>remote"
    # line per repo; <remote> is where the base branch lives.
    import argparse
    ap = argparse.ArgumentParser(prog="yo sweep")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--delete-branches", action="store_true")
    ap.add_argument("--include-stale", action="store_true")
    ap.add_argument("--include-suspended", action="store_true")
    ap.add_argument("--repo", action="append")
    opts = ap.parse_args(args)

    DEAD, STALE, SUSPENDED, KEEP = "DEAD", "STALE", "SUSP", "KEEP"
    repos = []
    for line in os.environ.get("YO_SWEEP_REPOS", "").splitlines():
        parts = line.split("\t")
        if len(parts) == 5 and (not opts.repo or parts[0] in opts.repo):
            repos.append(parts)
    if opts.repo:
        unknown = set(opts.repo) - {r[0] for r in repos}
        if unknown:
            print("yo sweep: unknown repo(s): " + ", ".join(sorted(unknown)), file=sys.stderr)
            sys.exit(1)

    def git(repo, *a, cwd=None):
        r = subprocess.run(["git", "-C", cwd or repo, *a], capture_output=True, text=True)
        return r.stdout.strip(), r.returncode

    def worktrees(repo):
        # Every worktree but the primary clone, which is never swept.
        out, _ = git(repo, "worktree", "list", "--porcelain")
        entries, cur = [], {}
        for line in out.splitlines():
            if line.startswith("worktree "):
                if cur:
                    entries.append(cur)
                cur = {"path": line[9:], "branch": None, "detached": False}
            elif line.startswith("branch "):
                cur["branch"] = line[7:].replace("refs/heads/", "")
            elif line == "detached":
                cur["detached"] = True
        if cur:
            entries.append(cur)
        return [e for e in entries if os.path.realpath(e["path"]) != os.path.realpath(repo)]

    def pr_index(gh_repo):
        # headRefName -> the most decisive PR on it. One listing per repo, not a
        # query per branch. Squash-merge means a merged branch isn't an
        # ancestor of base, so the merged PR is the only witness the work
        # landed. OPEN outranks anything earlier on a reused branch: it's in
        # use again.
        if not gh_repo:
            return None
        rank = {"MERGED": 3, "CLOSED": 2, "OPEN": 1}
        try:
            out = subprocess.run(
                ["gh", "pr", "list", "--repo", gh_repo, "--state", "all",
                 "--limit", "800", "--json", "number,headRefName,state"],
                capture_output=True, text=True, check=True).stdout
        except (subprocess.CalledProcessError, FileNotFoundError) as exc:
            print("  ! could not list PRs for %s: %s" % (gh_repo, exc), file=sys.stderr)
            return None
        idx = {}
        for pr in json.loads(out):
            head, prev = pr["headRefName"], idx.get(pr["headRefName"])
            if prev is None or rank[pr["state"]] > rank[prev["state"]]:
                if not (prev and prev["state"] == "OPEN"):
                    idx[head] = pr
        return idx

    try:
        here = os.path.realpath(os.getcwd())
    except FileNotFoundError:
        here = ""   # run from a directory that's since been removed
    live = live_sessions()
    ledger = load_all()

    def session_hold(path):
        # A session that still needs this worktree: one running in it now, or
        # one the ledger would bring back on resume-all (crashed, or its tab
        # was closed). A session ended with /exit holds nothing.
        rp = os.path.realpath(path)
        for rec in ledger:
            if os.path.realpath(rec["worktree"]) == rp and rec.get("home"):
                return KEEP, "%s's home (yo agent %s)" % (rec.get("agent"), rec.get("agent"))
        for d in live:
            if owns(rp, os.path.realpath(d.get("cwd", ""))):
                return KEEP, "live session, pid %s" % d["pid"]
        for rec in ledger:
            if os.path.realpath(rec["worktree"]) == rp and rec.get("sessionId") \
                    and not rec.get("endedAt"):
                return SUSPENDED, "suspended session (yo resume %s)" % rec.get("name")
        return None

    def classify(repo, base, wt, prs):
        path, branch = wt["path"], wt["branch"]
        if os.path.realpath(path) == here or here.startswith(os.path.realpath(path) + "/"):
            return KEEP, "current directory"
        if not os.path.isdir(path):
            return DEAD, "directory is gone (prunable)"
        held = session_hold(path)
        if held:
            return held

        dirty, _ = git(repo, "status", "--porcelain", cwd=path)
        n_dirty = len(dirty.splitlines()) if dirty else 0
        if wt["detached"]:
            # A PR-review checkout sits at the PR's head commit with no branch,
            # so nothing is lost by removing it.
            if n_dirty:
                return KEEP, "detached, %d uncommitted" % n_dirty
            return DEAD, "detached PR-review checkout"

        ahead, rc = git(repo, "rev-list", "--count", "%s..%s" % (base, branch))
        if rc != 0:
            return KEEP, "branch unreadable"
        ahead = int(ahead or 0)
        pr = (prs or {}).get(branch)
        prtxt = ("PR #%s %s" % (pr["number"], pr["state"].lower())) if pr else "no PR"
        if n_dirty:
            return KEEP, "%d uncommitted (%s)" % (n_dirty, prtxt)
        if pr and pr["state"] == "OPEN":
            return KEEP, "%s, %d commit(s)" % (prtxt, ahead)
        if pr and pr["state"] == "MERGED":
            return DEAD, "%s (squash-merged)" % prtxt
        if ahead == 0:
            return DEAD, "no commits beyond %s (%s)" % (base, prtxt)
        if pr and pr["state"] == "CLOSED":
            return STALE, "%s unmerged, %d commit(s) would be orphaned" % (prtxt, ahead)
        return STALE, "%d commit(s), no PR — unreviewed work" % ahead

    removable, total = [], 0
    for key, repo, base, gh, remote in repos:
        if not os.path.isdir(repo):
            print("\n%s: no clone at %s — skipped" % (key, repo))
            continue
        wts = worktrees(repo)
        if not wts:
            continue
        subprocess.run(["git", "-C", repo, "fetch", "--quiet", remote])
        base = remote + "/" + base
        prs = pr_index(gh)
        total += len(wts)
        print("\n%s  (%d worktrees, base %s)" % (key, len(wts), base))
        print("-" * 96)
        rows = []
        for wt in wts:
            verdict, why = classify(repo, base, wt, prs)
            rows.append((verdict, wt, why))
            if verdict == DEAD \
                    or (verdict == STALE and opts.include_stale) \
                    or (verdict == SUSPENDED and opts.include_suspended):
                removable.append((repo, wt))
        for verdict in (DEAD, STALE, SUSPENDED, KEEP):
            for v, wt, why in rows:
                if v == verdict:
                    print("  %-5s %-32s %-40s %s" % (v, os.path.basename(wt["path"]),
                                                     wt["branch"] or "(detached)", why))

    print("\n%d of %d worktrees removable." % (len(removable), total))
    if not removable:
        sys.exit(0)
    if not opts.apply:
        print("Dry run. Re-run with --apply to remove"
              + (", --delete-branches to drop their branches too." if not opts.delete_branches else "."))
        sys.exit(0)

    for repo, wt in removable:
        # No --force: a worktree that turned dirty since it was classified
        # refuses to be removed rather than losing the change.
        out, rc = git(repo, "worktree", "remove", wt["path"])
        if rc != 0 and os.path.isdir(wt["path"]):
            print("  ! kept %s: %s" % (os.path.basename(wt["path"]), out))
            continue
        try:
            os.unlink(os.path.join(state, wt_key(wt["path"]) + ".json"))
        except FileNotFoundError:
            pass
        print("  removed %s" % os.path.basename(wt["path"]))
        if opts.delete_branches and wt["branch"]:
            # -D, not -d: a squash-merged branch isn't an ancestor of base, so
            # -d refuses it. The reflog still holds the tip.
            _, brc = git(repo, "branch", "-D", wt["branch"])
            if brc == 0:
                print("    deleted branch %s" % wt["branch"])
    for key, repo, base, gh, remote in repos:
        if os.path.isdir(repo):
            git(repo, "worktree", "prune")
PY
}

# The hooks that keep the ledger current, as settings JSON for the session's
# layer. The path is single-quoted inside the hook command so a checkout under
# a path with spaces still runs.
_yo_hook_settings() {
  local h
  h=$(printf '[{"hooks":[{"type":"command","command":"%s _session-hook"}]}]' "'$YO_SELF'")
  printf '{"hooks":{"SessionStart":%s,"SessionEnd":%s}}' "$h" "$h"
}

# "clone<TAB>key<TAB>title-prefix<TAB>profile" per registered repo, for
# `_yo_state sync`.
_yo_clones_spec() {
  local k
  for k in $(_yo_repo_keys); do
    printf '%s\t%s\t%s\t%s\n' "$(repo_path_for "$k")" "$k" "$(title_prefix_for "$k")" \
      "$(_yo_field "$k" 11)"
  done
}

_yo_sync_ledger() {
  YO_CLONES="$(_yo_clones_spec)" _yo_state sync || true
}

# Splits one `_yo_state` TSV row into the R_* globals.
_yo_read_row() {
  IFS="$_YO_TAB" read -r R_STATUS R_PID R_NAME R_REPO R_SID R_WT R_TITLE R_KEY \
    R_PROFILE R_MODE R_GUEST R_AGENT R_HOME R_RC <<EOF
$1
EOF
  [ "$R_PID" = "-" ] && R_PID=""
  [ "$R_REPO" = "-" ] && R_REPO=""
  [ "$R_SID" = "-" ] && R_SID=""
  [ "$R_PROFILE" = "-" ] && R_PROFILE=""
  [ "$R_GUEST" = "-" ] && R_GUEST=""
  [ "${R_AGENT:-}" = "-" ] && R_AGENT=""
  [ "${R_HOME:-}" = "-" ] && R_HOME=""
  [ "${R_RC:-}" = "-" ] && R_RC=""
  return 0
}

# Closes the iTerm tab holding THIS process's session, found by the session id
# iTerm exports to every shell it starts (ITERM_SESSION_ID=w0t1p0:<uuid>). Not
# "the current tab": when yo runs from a remote-controlled or background
# session, focus is somewhere else entirely and the current tab is somebody
# else's. Closing the tab ends both panes, and the window with it if it was the
# last tab. Errors are ignored because the close also kills osascript itself.
close_iterm_own_tab() {
  if [ -z "${ITERM_SESSION_ID:-}" ]; then
    echo "yo: not running inside an iTerm2 session; leaving windows alone (exit claude yourself)"
    return 0
  fi
  /usr/bin/osascript - "${ITERM_SESSION_ID#*:}" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  set want to item 1 of argv
  tell application "iTerm2"
    repeat with ww in windows
      repeat with tt in tabs of ww
        repeat with ss in sessions of tt
          if (unique id of ss) is want then
            close tt
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

# --- claude settings layer ----------------------------------------------------
# yo never edits ~/.claude/settings.json — Claude Code and iTerm2's integration
# both write that file. It stacks its settings on top instead: `claude
# --settings <file>` loads a layer that outranks every settings file on disk
# (user, project, local), with arrays such as hooks and permissions merged
# rather than replaced. The layer is the installed claude-settings.json plus
# the profile's own settings file plus this session's autoMemoryDirectory —
# which has to arrive this way (or from
# user settings), since Claude ignores that key in project settings — plus the
# session ledger's hooks. `--settings` takes one value, so everything yo adds
# has to be in this one file.
#
# Echoes the path of the composed file.
compose_session_settings() {
  local memory_dir="$1" label="$2" extra="$3" layer out
  layer="${YO_CLAUDE_SETTINGS:-$(dirname "$(_yo_config_path)")/claude-settings.json}"
  [ -f "$layer" ] || layer=""
  out="${XDG_STATE_HOME:-$HOME/.local/state}/yo/settings/${label}.json"
  mkdir -p "$(dirname "$out")"
  python3 - "$out" "$layer" "$extra" "$memory_dir" "$(_yo_hook_settings)" <<'PY_EOF' || return 1
import json, os, sys
out, layer, extra, memory_dir, hooks = sys.argv[1:6]
# The profile's settings go over the base layer: objects merge key by key,
# lists (permissions.allow, a hook event's entries) are appended to, anything
# else is replaced.
def merge(a, b):
    for k, v in b.items():
        if isinstance(v, dict) and isinstance(a.get(k), dict):
            merge(a[k], v)
        elif isinstance(v, list) and isinstance(a.get(k), list):
            a[k] = a[k] + [x for x in v if x not in a[k]]
        else:
            a[k] = v
d = {}
for path in (layer, extra):
    if path:
        with open(path) as f:
            merge(d, json.load(f))
merge(d, json.loads(hooks))
if memory_dir:
    d["autoMemoryDirectory"] = memory_dir
tmp = out + ".tmp"
with open(tmp, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
os.replace(tmp, out)
PY_EOF
  printf '%s' "$out"
}

# " --model 'M'" for a claude command line, or nothing. Session-scoped: the
# flag never touches the default in settings.json, and a later plain
# `claude --resume` keeps whatever model the session last ran on.
_yo_model_arg() {
  [ -n "$1" ] || return 0
  case "$1" in
    *[!A-Za-z0-9._:\[\]-]*) die "--model: unexpected characters in '$1' (an alias like opus, sonnet[1m], haiku, or a full model id)" ;;
  esac
  printf ' --model %s' "$(shell_single_quote "$1")"
}

# Builds a session's first message into COMPOSED_MSG (and its codename into
# COMPOSED_PERSONA): the mode's own message, then [extra], then the report-back
# instruction (--from), then the codename. One line — the command is written
# into the pane as a single shell line, so no embedded newlines.
_yo_compose_message() {
  local msg="$1" extra="$2" report_to="$3" agent_display="${4:-}" fixed_persona="${5:-}"
  if [ -n "$extra" ]; then
    msg="${msg:+$msg }$extra"
  fi
  if [ -n "$report_to" ]; then
    msg="${msg:+$msg }When you finish, or get blocked on something only a person can decide, report back to the Claude session named \"${report_to}\" with SendMessage: a few lines on the outcome and where the work is (branch, PR, files). Do the work in this session; don't hand it back."
  fi
  # Every session gets a persona, and claude is told up front — partly for fun,
  # partly so sessions can identify themselves in notes and messages.
  # An agent's sessions lead with its name ("Cindy · Plucky Gary"), so several
  # of them stay apart in ListAgents, tabs and the notes they sign.
  COMPOSED_PERSONA="${fixed_persona:-$(fun_session_title)}"
  [ -n "$agent_display" ] && [ -z "$fixed_persona" ] \
    && COMPOSED_PERSONA="${agent_display} · ${COMPOSED_PERSONA}"
  if [ -n "$msg" ]; then
    COMPOSED_MSG="${msg} (FYI, your codename for this session is \"${COMPOSED_PERSONA}\" — introduce yourself with it and use it whenever you identify this session, e.g. in notes, PR comments you're asked to post, or messages.)"
  else
    COMPOSED_MSG="Your codename for this session is \"${COMPOSED_PERSONA}\". Briefly introduce yourself by codename, then wait for instructions."
  fi
}

# --- create -------------------------------------------------------------------
# Where a session goes when a profile was picked and no repo was named. Works
# on cmd_up's locals, like create_session_worktree below: sets repo_key and
# repo_named, or profile_dir when the profile's home isn't a registered clone
# (there is nothing to take a worktree from, so the caller runs it in place).
resolve_profile_target() {
  local dir
  dir=$(_yo_pfield "$YO_PROFILE_SELECTED" 7)
  if [ -n "$dir" ]; then
    if repo_key=$(_yo_repo_at "$dir"); then
      repo_named=1
    else
      repo_key=""
      profile_dir="$dir"
    fi
    return 0
  fi
  # No home directory: the cwd's repo if it is one of the profile's, else the
  # first repo registered under the profile.
  repo_key=$(detect_repo_key || true)
  if [ -z "$repo_key" ] \
      || [ "$(_yo_field "$repo_key" 11)" != "$YO_PROFILE_SELECTED" ]; then
    repo_key=$(_yo_repos_of_profile "$YO_PROFILE_SELECTED" | head -1)
    [ -n "$repo_key" ] && repo_named=1
  fi
  [ -n "$repo_key" ] || die "profile '$YO_PROFILE_SELECTED' has no --dir and no repos
        give it one in $(_yo_config_path), or name a repo: yo --profile=$YO_PROFILE_SELECTED --repo=<repo>"
}

# The worktree half of cmd_up: resolve the branch, fetch, add the worktree, and
# get Claude's per-folder state in place. Skipped entirely under --here.
# Works on cmd_up's own locals (bash scoping is dynamic): reads repo_key, input,
# gh_kind and pr_review; may rewrite name; sets wt_path.
create_session_worktree() {
  local repo_path
  repo_path=$(repo_path_for "$repo_key") \
    || die "unknown repo '$repo_key' (known: $(_yo_repo_list))"
  [ -d "$repo_path/.git" ] || die "no clone at: $repo_path
        clone '$repo_key' there, or fix its --path in $(_yo_config_path)"
  base_ref=$(base_ref_for "$repo_key")
  # Merged agents only: checked against the base branch before anything is created.
  [ -z "$agent" ] \
    || _yo_agent_check "$agent" "$repo_path" "$(_yo_upstream_remote "$repo_key")/$base_ref"

  # Branch-vs-name resolution for a plain INPUT: if it names an existing branch
  # verbatim (local or on origin — e.g. `yo sagark/rollbacks`), use THAT
  # branch; otherwise it's a session name and the branch is <prefix>/<name> (whose
  # own exists-locally/exists-on-origin reuse is handled below).
  local branch prefix
  prefix=$(branch_prefix_for "$repo_key")
  if [ -n "$input" ] && [ -z "$gh_kind" ]; then
    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$input" \
        || git -C "$repo_path" ls-remote --exit-code --heads origin "$input" >/dev/null 2>&1; then
      explicit_branch="$input"
    fi
  fi
  if [ -n "$explicit_branch" ]; then
    branch="$explicit_branch"
    # Worktree dir + title come from the branch, minus the <prefix>/ part, with
    # any remaining slashes flattened so the dir isn't nested.
    name="${explicit_branch#"$prefix"/}"
    name="${name//\//-}"
  else
    # A slash in a non-branch INPUT is usually a deleted/typo'd branch name —
    # flatten it so the session name/dir/branch don't nest, and say so.
    if [ "${name#*/}" != "$name" ]; then
      echo "==> note: '$name' doesn't match any existing branch; treating it as a session name (flattened: ${name//\//-})"
      name="${name//\//-}"
    fi
    branch="$prefix/$name"
  fi
  local wt_root="${repo_path}-worktrees"
  wt_path="$wt_root/$name"
  # The remote the repo's PR heads and base branch come from (see
  # _yo_upstream_remote); your own branches are looked up on origin.
  local upstream_remote
  upstream_remote=$(_yo_upstream_remote "$repo_key")

  [ -e "$wt_path" ] && die "worktree path already exists: $wt_path"

  # Branch resolution, three ways:
  #   reuse=1        <prefix>/<name> exists locally -> check IT out in the new
  #                  worktree (restarting a session on the same branch). git
  #                  refuses if it's checked out in another worktree/clone —
  #                  that error is clearer than anything we'd synthesize.
  #   remote_reuse=1 only origin/<prefix>/<name> exists -> create a local tracking
  #                  branch from it.
  #   neither        fresh branch from the repo's base branch (or PR head).
  local reuse=0 remote_reuse=0
  if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"; then
    reuse=1
  elif [ "$pr_review" -eq 0 ] \
      && git -C "$repo_path" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    remote_reuse=1
  fi

  # Decide what to fetch and where the worktree starts. Default: the repo's
  # base branch (base_ref_for).
  # PR review: GitHub publishes every PR's head at refs/pull/<n>/head on the
  # repo the PR is against (true even for a PR from someone else's fork), so we
  # fetch that from the repo's remote, start the worktree at that exact commit,
  # and (below the worktree add) wire the branch to track that ref so `git pull`
  # refreshes it — no gh, no fork-remote juggling.
  local fetch_ref fetch_remote fetch_desc start_point
  if [ "$reuse" -eq 1 ]; then
    fetch_ref=""  # nothing to fetch: the branch is the start point, as-is.
    fetch_remote=""
    fetch_desc="existing local branch"
  elif [ "$pr_review" -eq 1 ]; then
    fetch_ref="pull/${GH_NUMBER}/head"
    fetch_remote="$upstream_remote"
    fetch_desc="PR #${GH_NUMBER} head (from $upstream_remote)"
  elif [ "$remote_reuse" -eq 1 ]; then
    fetch_ref="$branch"
    fetch_remote="origin"
    fetch_desc="origin/$branch (existing remote branch)"
  else
    fetch_ref="$base_ref"
    fetch_remote="$upstream_remote"
    fetch_desc="${upstream_remote}/$base_ref"
  fi

  if [ -n "$fetch_ref" ]; then
    echo "==> [$repo_key] fetching $fetch_desc"
    git -C "$repo_path" fetch "$fetch_remote" "$fetch_ref"
  fi
  if [ "$pr_review" -eq 1 ]; then
    # FETCH_HEAD now points at the just-fetched PR head; pin its SHA as the
    # worktree start point.
    start_point=$(git -C "$repo_path" rev-parse FETCH_HEAD) \
      || die "couldn't resolve PR #${GH_NUMBER} head after fetch"
  elif [ "$remote_reuse" -eq 1 ]; then
    start_point="origin/$branch"
  else
    start_point="${upstream_remote}/$base_ref"
  fi

  mkdir -p "$wt_root"
  echo "==> creating worktree: $wt_path"
  if [ "$reuse" -eq 1 ]; then
    echo "        branch: $branch (REUSING existing local branch, as-is)"
    git -C "$repo_path" worktree add "$wt_path" "$branch"
    if git -C "$repo_path" config "branch.${branch}.merge" >/dev/null 2>&1; then
      echo "        note: branch tracks $(git -C "$repo_path" config "branch.${branch}.merge") — 'git pull' in the worktree to refresh"
    fi
  elif [ "$remote_reuse" -eq 1 ]; then
    echo "        branch: $branch (new local branch tracking origin/$branch)"
    git -C "$repo_path" worktree add --track -b "$branch" "$wt_path" "$start_point"
  else
    echo "        branch: $branch (from $fetch_desc)"
    git -C "$repo_path" worktree add -b "$branch" "$wt_path" "$start_point"
  fi

  if [ "$pr_review" -eq 1 ] && [ "$reuse" -eq 0 ]; then
    # Track the PR head so `git pull` inside the worktree pulls new PR commits
    # (reviews iterate — the author pushes fixups). We track refs/pull/<n>/head:
    # `git pull` fetches that exact ref and merges it (config is repo-wide, so
    # set it via the main clone; it applies to the branch in the worktree).
    # New commits fast-forward; a force-push/rebase turns pull into a merge, so
    # `git reset --hard FETCH_HEAD` (or recreate the session) to resync then.
    git -C "$repo_path" config "branch.${branch}.remote" "$upstream_remote"
    git -C "$repo_path" config "branch.${branch}.merge" "refs/pull/${GH_NUMBER}/head"
    echo "        tracking ${upstream_remote} refs/pull/${GH_NUMBER}/head — git pull refreshes the PR"
  fi

  # A guest repo is somebody else's code that nobody here has vetted, and it
  # can configure hooks and MCP servers — so its trust dialog is left to appear.
  # A profile can ask for the same (trust: false).
  if ! repo_trusted "$repo_key"; then
    echo "==> not pre-trusting the worktree ($repo_key isn't a trusted repo) — Claude will ask"
    return 0
  fi

  echo "==> pre-trusting worktree in ~/.claude.json"
  seed_trust "$wt_path" "$repo_path" \
    || echo "yo: trust-seed skipped (couldn't update ~/.claude.json; Claude will prompt)"
  mirror_local_settings "$wt_path" "$repo_path" "$repo_key"
  mirror_repo_files "$wt_path" "$repo_path" "$repo_key"
}

cmd_up() {
  # Most sessions branch a fresh <prefix>/<name> off the repo's base branch. A PR-review session
  # instead points the worktree at the PR's own head commit (pr_review=1) so the
  # local tree IS the code under review — see the fetch/create step below.
  local repo_key="" name initial_msg="" extra_msg="" base_ref pr_review=0
  local repo_override="" input="" gh_kind="" gh_number="" gh_owner_repo=""
  local explicit_branch="" unnamed=0 persona="" force_new_window=-1
  local here=0 mode="" wt_path="" repo_named=0 url_repo="" profile_dir="" add_to=""
  local title_override="" report_to="" model="" agent="" agent_repo="" agent_display=""

  # Flags may appear anywhere; strip them out of the positional args.
  local args=() a
  for a in "$@"; do
    case "$a" in
      --repo=*) repo_override="${a#--repo=}"
                repo_path_for "$repo_override" >/dev/null 2>&1 \
                  || die "--repo must be one of: $(_yo_repo_list) (got: '$repo_override')" ;;
      --new-window|--window) force_new_window=1 ;;
      --tab)                 force_new_window=0 ;;
      --profile=*) YO_PROFILE_SELECTED="${a#--profile=}"
                _yo_pfield "$YO_PROFILE_SELECTED" 1 >/dev/null 2>&1 \
                  || die "--profile must be one of: $(_yo_profile_names | paste -sd'|' - | sed 's/|/ | /g') (got: '$YO_PROFILE_SELECTED')" ;;
      --here|--in-place)     mode="here" ;;
      --worktree)            mode="worktree" ;;
      --add-to=*)            add_to="${a#--add-to=}"
                             [ -n "$add_to" ] || die "--add-to needs a profile, or guest" ;;
      --title=*)             title_override="${a#--title=}"
                             [ -n "$title_override" ] || die "--title needs a value" ;;
      --from=*)              report_to="${a#--from=}"
                             [ -n "$report_to" ] || die "--from needs a session name" ;;
      --model=*)             model="${a#--model=}"
                             [ -n "$model" ] || die "--model needs a value"
                             _yo_model_arg "$model" >/dev/null ;;   # validate now, before anything is created
      --agent=*)             agent="${a#--agent=}"
                             _yo_agent_name_ok "$agent" || die "--agent: names may only contain letters, digits, . _ - (got: '$agent')" ;;
      --*)      die "unknown flag: $a" ;;
      *)        args+=("$a") ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}

  # Legacy positional repo: `yo <repo> [<name> [extra]]`. A lone repo arg
  # (`yo <repo>`) means an unnamed session in that repo.
  # `yo <profile> ...` works the same way; a repo of that name wins.
  if [ "$#" -ge 1 ] && repo_path_for "$1" >/dev/null 2>&1; then
    repo_override="$1"; shift
  elif [ "$#" -ge 1 ] && [ -z "$YO_PROFILE_SELECTED" ] && [ -z "$repo_override" ] \
      && _yo_pfield "$1" 1 >/dev/null 2>&1; then
    YO_PROFILE_SELECTED="$1"; shift
  fi
  [ "$#" -le 2 ] || die "usage: yo [--repo=R] [--profile=P] [--here|--worktree] [--title=T] [--from=S] [--model=M] [--agent=NAME] [INPUT] [extra]"
  input="${1:-}"; extra_msg="${2:-}"

  if [ -n "$agent" ]; then
    agent_display=$(_yo_agent_display "$agent")
    # A registered agent's repo stands in where yo would otherwise infer one.
    agent_repo=$(_yo_agent_field "$agent" 2 2>/dev/null || true)
  fi

  # Which repo. One that was NAMED (--repo, the positional form, a URL, or the
  # default repo standing in for a cwd yo doesn't know) is also where an
  # in-place session runs. One merely inferred from the cwd is not: there, in
  # place means the cwd itself (a worktree, a subdirectory, ...).
  if [ -n "$input" ] && parse_github_url "$input"; then
    # PR/issue URL mode: kind, number, and (default) repo derive from the URL.
    gh_kind="$GH_KIND"; gh_number="$GH_NUMBER"; gh_owner_repo="$GH_OWNER_REPO"
    url_repo="$GH_REPO_KEY"
    # A repo nobody registered: bring it in as a guest, unless the session
    # was pointed somewhere itself (--repo, --here).
    # An issue is only context, so an agent's own repo counts as pointed too.
    local issue_repo=""
    [ "$GH_KIND" = "issue" ] && issue_repo="$agent_repo"
    if [ -z "$url_repo" ] && [ -z "$repo_override" ] && [ -z "$issue_repo" ] \
        && [ "$mode" != "here" ]; then
      place_url_repo "$gh_owner_repo" "$add_to"
      url_repo="$YO_URL_REPO"
    fi
    # Issues are just context — the WORK may live in the other repo
    # (e.g. --repo=<other> for an issue tracked in a different repo).
    repo_key="${repo_override:-${issue_repo:-$url_repo}}"
    [ -n "$repo_key" ] && repo_named=1
    if [ "$GH_KIND" = "pr" ]; then
      name="review_pr_${GH_NUMBER}"
      initial_msg="${YO_REVIEW_CMD_RESOLVED} ${GH_URL}"
      # An agent reviews by its own instructions, not the personal review command.
      [ -n "$agent" ] && initial_msg="Review the pull request ${GH_URL} as your instructions describe."
      pr_review=1
    else
      name="issue_${GH_NUMBER}"
      initial_msg="take a look at the following issue, and work with me to address it: ${GH_URL} review the issue, its comments, any parent issue context you may need. then give me your take on it before doing any work. Issues may need to be broken down first, or we may only focus on a part of it."
      # An agent works the issue by its own instructions (claiming it, recording
      # progress on it), rather than the take-first brief a person gets.
      [ -n "$agent" ] && initial_msg="Take the issue ${GH_URL}: read it, its comments and any parent issue, then work it as your instructions describe."
    fi
  else
    if [ -z "$input" ] || [ "$input" = "-" ]; then
      # Unnamed session: timestamped branch/dir, fun window title. Bare `yo`
      # lands here; `-` is the explicit spelling so an [extra] can follow:
      #   yo - 'prod is broken, investigate!'
      name="sesh_$(date +%Y%m%d_%H%M%S)"
      unnamed=1
    else
      name="$input"   # provisional; branch-vs-name resolution happens below
    fi
    # Repo: --repo wins, then cwd inference. An unnamed session then falls
    # back to the default repo — bare `yo` from anywhere should just work —
    # unless --here asked for this very directory.
    if [ -n "$repo_override" ]; then
      repo_key="$repo_override"; repo_named=1
    elif [ -n "$agent_repo" ] && [ "$mode" != "here" ]; then
      repo_key="$agent_repo"; repo_named=1
    elif [ -n "$YO_PROFILE_SELECTED" ] && [ "$mode" != "here" ]; then
      resolve_profile_target
    else
      repo_key=$(detect_repo_key || true)
      if [ -z "$repo_key" ] && [ "$unnamed" -eq 1 ] && [ "$mode" != "here" ]; then
        repo_key=$(default_repo_key)
        [ -n "$repo_key" ] && repo_named=1
      fi
    fi
  fi

  # Worktree or in place: the flag, else the repo's --mode, else its
  # profile's, else YO_MODE. A profile home that is no registered clone has
  # nothing to take a worktree from.
  if [ -n "$profile_dir" ]; then
    [ "$mode" = "worktree" ] \
      && die "--worktree: $profile_dir isn't a registered clone, so there is nothing to take a worktree from"
    mode="here"
  fi
  [ -n "$mode" ] || mode=$(mode_for "$repo_key")
  [ "$mode" = "here" ] && here=1

  if [ "$here" -eq 0 ]; then
    if [ "$pr_review" -eq 1 ]; then
      # The worktree is checked out from refs/pull/<n>/head on the PR's own
      # repo — a different --repo can't hold that ref, so it's an error.
      [ -n "$url_repo" ] || die_unknown_url_repo "$gh_owner_repo"
      if [ "$repo_key" != "$url_repo" ]; then
        die "--repo=$repo_key conflicts with PR URL repo ($url_repo): the worktree must come from the PR's repo"
      fi
    elif [ -n "$gh_kind" ]; then
      [ -n "$repo_key" ] || die_unknown_url_repo "$gh_owner_repo"
    fi
    [ -n "$repo_key" ] || die "no repo given and couldn't infer one from $(pwd)
        run inside a known clone, or: yo --repo=<repo> <INPUT>
        (or --here, to work in this directory as it is)
        known repos: $(_yo_repo_list)"
  fi
  if [ "$gh_kind" = "issue" ] && [ -n "$repo_key" ] && [ "$repo_key" != "$url_repo" ]; then
    initial_msg="${initial_msg} NOTE: the issue lives in ${gh_owner_repo}, but this session works in the ${repo_key} repo — that's where the work is expected to land."
  fi
  if [ "$here" -eq 1 ] && [ "$pr_review" -eq 1 ]; then
    initial_msg="${initial_msg} NOTE: this session runs in place — the PR's head was NOT checked out, so the local tree may not be the code under review."
  fi

  _yo_compose_message "$initial_msg" "$extra_msg" "$report_to" "$agent_display"
  initial_msg="$COMPOSED_MSG"; persona="$COMPOSED_PERSONA"

  case "$name" in
    *[!A-Za-z0-9._/-]*) die "name may only contain letters, digits, . _ / - (got: '$name')" ;;
  esac

  if [ "$here" -eq 1 ]; then
    if [ -n "$profile_dir" ]; then
      wt_path="$profile_dir"
      [ -d "$wt_path" ] || die "profile '$YO_PROFILE_SELECTED': no directory at $wt_path
        fix its --dir in $(_yo_config_path)"
    elif [ "$repo_named" -eq 1 ]; then
      wt_path=$(repo_path_for "$repo_key")
      [ -d "$wt_path" ] || die "no clone at: $wt_path
        clone '$repo_key' there, or fix its --path in $(_yo_config_path)"
    else
      wt_path="."
    fi
    # Physical path: it's what Claude keys its per-folder records on.
    wt_path=$(cd "$wt_path" && pwd -P)
    local here_branch
    here_branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || true)
    echo "==> session in place: $wt_path"
    [ -n "$here_branch" ] && echo "        branch: $here_branch"
    echo "        as checked out — nothing fetched, pulled or created"
    # Loud where it bites: these two normally start from fresh code.
    if [ "$pr_review" -eq 1 ]; then
      echo "yo: WARNING: PR #${gh_number} is NOT checked out — the review runs against the tree above"
    elif [ -n "$gh_kind" ]; then
      echo "yo: WARNING: not starting from the latest base branch — pull first if that matters"
    fi
    # No trust seeding here: yo didn't create this directory, so whether to
    # trust it stays Claude's question to ask.
    [ -z "$agent" ] || _yo_agent_check "$agent" "$wt_path"
  else
    create_session_worktree
  fi

  # Window title rules (issue/PR numbers are impossible to keep in your head):
  #   non-default repos:    "[<repo>] ..." prefix (see title_prefix_for)
  #   PR review sessions:   "PR#1234: <PR title>"      (via gh, 50-char cap)
  #   issue sessions:       "Issue#1234: <issue title>" (via gh, 50-char cap)
  #   unnamed sessions:     the fun title ("Adventurous Possum")
  #   everything else:      the session name
  local label win_title="$name"
  label=$(session_label "$repo_key" "$wt_path")
  if [ -n "$gh_kind" ]; then
    local gh_title=""
    if command -v gh >/dev/null 2>&1; then
      case "$gh_kind" in
        pr)    gh_title=$(gh pr view "$gh_number" --repo "$gh_owner_repo" --json title --jq .title 2>/dev/null || true) ;;
        issue) gh_title=$(gh issue view "$gh_number" --repo "$gh_owner_repo" --json title --jq .title 2>/dev/null || true) ;;
      esac
    fi
    if [ -n "$gh_title" ]; then
      case "$gh_kind" in
        pr)    win_title=$(truncate_title "PR#${gh_number}: ${gh_title}") ;;
        issue) win_title=$(truncate_title "Issue#${gh_number}: ${gh_title}") ;;
      esac
    fi
  elif [ "$unnamed" -eq 1 ]; then
    win_title="$persona"
  fi
  # An agent's tab leads with its name (an unnamed one already does, via the persona).
  if [ -n "$agent" ] && [ "$unnamed" -eq 0 ]; then
    win_title="${agent_display} · ${win_title}"
  fi
  win_title="$(session_title_prefix "$repo_key" "$label")$win_title"
  [ -n "$title_override" ] && win_title="$title_override"

  # The session id is chosen here rather than by claude, so the ledger knows
  # it before claude has even started — which is what lets `yo resume-all`
  # bring this session back after a crash.
  local session_id session_key guest=""
  session_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  [ -n "$repo_key" ] && [ "$repo_key" = "$YO_GUEST_REPO" ] \
    && guest=$(_yo_github_for "$repo_key")
  session_key=$(_yo_state put "$wt_path" "$session_id" "$win_title" "$repo_key" \
    "$name" "$(profile_for "$repo_key")" "$(mode_word "$here")" "$guest" "$agent") \
    || { session_key=""; echo "yo: couldn't record the session in $YO_STATE_DIR (resume-all won't know about it)"; }

  # Seed the left-pane claude with an initial message when we have one (PR/issue
  # URL mode, and/or the [extra] arg). Single-quote wrapping, NOT printf %q:
  # %q backslash-escapes every space, which made the pane's command line an
  # unreadable '\ ' blizzard. Wrapping in single quotes (with the standard
  # '\'' dance for any embedded single quote) is equally shell-safe and reads
  # like what it is.
  prepare_claude_cmd "$repo_key" "$label" "$session_key"
  local claude_cmd
  claude_cmd="$YO_CLAUDE_LINE$(_yo_model_arg "$model")$(_yo_agent_arg "$agent") --session-id $session_id"
  if [ -n "$initial_msg" ]; then
    claude_cmd="$claude_cmd $(shell_single_quote "$initial_msg")"
  fi

  echo "        persona: $persona"
  echo "        session: $session_id"
  [ -n "$agent" ] && echo "        agent:   $agent"
  [ -n "$model" ] && echo "        model:   $model"
  [ -n "$initial_msg" ] && echo "        seeding claude with: $initial_msg"
  launch_session "$wt_path" "$win_title" "$claude_cmd" "$repo_key" "$label" \
    "$force_new_window"
  echo "==> ready."
}

# here=1|0 -> the mode word the ledger records.
mode_word() { if [ "$1" -eq 1 ]; then printf 'here'; else printf 'worktree'; fi; }

# What a session is filed under: its repo, else the profile that was picked,
# else (a --here session somewhere yo doesn't know) the directory.
session_label() {
  local pname
  pname=$(profile_for "$1")
  printf '%s' "${1:-${pname:-$(basename "$2")}}"
}

# The window-title prefix: the repo's (see title_prefix_for), else "[<label>] ".
session_title_prefix() {
  if [ -n "$1" ]; then title_prefix_for "$1"; else printf '[%s] ' "$2"; fi
}

# The claude command line for a session in repo <key> (may be empty), filed
# under <label>: the repo's or profile's claude command, run with
# YO_SESSION_KEY=<session_key> so the ledger hooks know their record, plus the
# composed settings layer. Sets YO_CLAUDE_LINE; the caller adds --session-id
# or --resume and any initial message. Used both to create a session and to
# resume one, so a resumed session gets the same layer it started with.
prepare_claude_cmd() {
  local repo_key="$1" label="$2" session_key="$3"
  local pname memory_dir settings_file="" profile_settings settings_name="$label"
  pname=$(profile_for "$repo_key")
  [ -n "$pname" ] && echo "==> profile: $pname"

  memory_dir=$(memory_dir_for "$repo_key")
  if [ -n "$memory_dir" ]; then
    if mkdir -p "$memory_dir" 2>/dev/null; then
      echo "==> memory: $memory_dir"
    else
      echo "yo: couldn't create $memory_dir — using Claude's default memory"
      memory_dir=""
    fi
  fi
  profile_settings=$(_yo_profile_value "$repo_key" 6)
  if [ -n "$profile_settings" ] && [ ! -f "$profile_settings" ]; then
    die "profile '$pname': no settings file at $profile_settings"
  fi
  [ -n "$pname" ] && [ "$pname" != "$label" ] && settings_name="$pname.$label"
  settings_file=$(compose_session_settings "$memory_dir" "$settings_name" "$profile_settings") \
    || { settings_file=""; echo "yo: couldn't compose the settings layer; launching claude without it (the ledger won't follow /clear)"; }

  YO_CLAUDE_LINE=$(claude_cmd_for "$repo_key")
  [ -n "$session_key" ] \
    && YO_CLAUDE_LINE="YO_SESSION_KEY=$(shell_single_quote "$session_key") $YO_CLAUDE_LINE"
  [ -n "$settings_file" ] \
    && YO_CLAUDE_LINE="$YO_CLAUDE_LINE --settings $(shell_single_quote "$settings_file")"
  return 0
}

# Opens the iTerm tab (or window) for a session and starts claude in it.
# force_new_window: 1 = new window, 0 = tab in the shared window, -1 = config.
launch_session() {
  local wt_path="$1" win_title="$2" claude_cmd="$3" repo_key="$4" label="$5"
  local force_new_window="$6"

  # YO_DRY_LAUNCH=1 prints what would run instead of opening iTerm: for testing
  # yo itself by path, against a throwaway HOME and config.
  if [ -n "${YO_DRY_LAUNCH:-}" ]; then
    printf 'dry launch: [%s] in %s\n  %s\n' "$win_title" "$wt_path" "$claude_cmd"
    return 0
  fi

  # ensure the title-locked iTerm profile exists (falls back to default profile)
  local profile="$WORKSESH_PROFILE_NAME" wrote
  if wrote=$(ensure_iterm_profile); then
    [ "$wrote" = "WROTE" ] && sleep 1.5   # let iTerm load the (re)written profile
  else
    profile=""
    echo "yo: couldn't build the '$WORKSESH_PROFILE_NAME' profile; using default (title may be overwritten by claude)"
  fi

  # Which window this session joins. The group is a plain label, so setting
  # YO_WINDOW_GROUP to something containing {repo} gives one window per repo.
  local win_group force_new
  win_group=$(window_group_for "$repo_key")
  win_group="${win_group//\{repo\}/$label}"
  if [ "$force_new_window" -ge 0 ]; then
    force_new="$force_new_window"
  elif [ "$YO_WINDOW_MODE_RESOLVED" = "window" ]; then
    force_new=1
  else
    force_new=0
  fi

  local layout="$YO_LAYOUT_RESOLVED" do_split=1 panes
  if [ "$layout" = "auto" ]; then
    if iterm_workgroup_has_peer; then layout="workgroup"; else layout="split"; fi
  fi
  if [ "$layout" = "workgroup" ]; then
    do_split=0
    panes="claude alone; the shell is the workgroup's terminal peer"
  else
    panes="claude in left pane, shell in right"
  fi

  if [ "$force_new" -eq 1 ]; then
    echo "==> opening iTerm2 window '$win_title' ($panes)"
  else
    echo "==> opening iTerm2 tab '$win_title' in the '$win_group' window ($panes)"
  fi
  open_iterm_session "$wt_path" "$win_title" "$claude_cmd" "$profile" \
    "yo:$win_group" "$force_new" "$do_split"
  reassert_session_title "$win_title"
}

# --- resume -------------------------------------------------------------------
# A guest repo (one a PR/issue URL brought in) is registered only for the run
# that brought it in. Echoes the key a recorded repo goes by now; non-zero when
# it isn't registered (any more).
_yo_ensure_repo() {
  local key="$1" guest="$2" k
  _yo_field "$key" 1 >/dev/null 2>&1 && { printf '%s' "$key"; return 0; }
  if [ -n "$guest" ]; then
    k=$(repo_key_from_url "https://github.com/$guest") && { printf '%s' "$k"; return 0; }
  fi
  return 1
}

# Relaunches the session in the R_* globals, under the repo and profile it was
# created with, so it gets the same settings layer, memory and window. Without
# a model it resumes on the model it last ran on; a message becomes its first
# prompt.
_yo_resume_row() {
  local force_new_window="$1" model="${2:-}" message="${3:-}"
  local repo_key="" saved_profile="$YO_PROFILE_SELECTED"
  if [ -n "$R_REPO" ]; then
    if ! repo_key=$(_yo_ensure_repo "$R_REPO" "$R_GUEST"); then
      if [ -n "$R_GUEST" ]; then
        # Registers it again, from the clone that's already there.
        register_url_repo "$R_GUEST"
        repo_key="$YO_GUEST_REPO"
      else
        echo "yo: repo '$R_REPO' is no longer configured; resuming $R_NAME without its settings"
        repo_key=""
      fi
    fi
  fi
  YO_PROFILE_SELECTED=""
  if [ -n "$R_PROFILE" ]; then
    if _yo_pfield "$R_PROFILE" 1 >/dev/null 2>&1; then
      YO_PROFILE_SELECTED="$R_PROFILE"
    else
      echo "yo: profile '$R_PROFILE' is no longer defined; resuming $R_NAME without it"
    fi
  fi

  echo "==> resuming $R_NAME ($R_SID) in $R_WT${R_AGENT:+ as $R_AGENT}"
  local label
  label=$(session_label "$repo_key" "$R_WT")
  prepare_claude_cmd "$repo_key" "$label" "$R_KEY"
  # The agent and Remote Control name come back from the ledger: nothing says
  # `claude --resume` restores either on its own.
  launch_session "$R_WT" "$R_TITLE" \
    "$YO_CLAUDE_LINE$(_yo_model_arg "$model")$(_yo_agent_arg "${R_AGENT:-}")$(_yo_rc_arg "${R_RC:-}") --resume $R_SID${message:+ $(shell_single_quote "$message")}" \
    "$repo_key" "$label" "$force_new_window"
  YO_PROFILE_SELECTED="$saved_profile"
}

# Where a directory sits in yo's world, for a session yo didn't start. Sets
# D_DIR (a yo worktree's root, else the directory as given), D_REPO, D_NAME,
# D_MODE (worktree only for a yo worktree) and D_TITLE.
_yo_classify_dir() {
  local dir="$1" k clone
  D_DIR="$dir"; D_REPO=""; D_NAME=""; D_MODE="here"
  for k in $(_yo_repo_keys); do
    clone=$(repo_path_for "$k")
    case "$dir/" in
      "$clone-worktrees/"*)
        D_REPO="$k"
        D_NAME="${dir#"$clone-worktrees/"}"; D_NAME="${D_NAME%%/*}"
        D_DIR="$clone-worktrees/$D_NAME"
        D_MODE="worktree"
        break ;;
      "$clone/"*)
        D_REPO="$k"
        D_NAME="$(basename "$clone")" ;;
    esac
  done
  [ -n "$D_NAME" ] || D_NAME=$(basename "$dir")
  D_TITLE="$(session_title_prefix "$D_REPO" "$(session_label "$D_REPO" "$D_DIR")")$D_NAME"
}

cmd_sessions() {
  _yo_sync_ledger
  local rows
  rows=$(_yo_state list)
  if [ -z "$rows" ]; then
    echo "no sessions in the ledger ($YO_STATE_DIR)"
    return 0
  fi
  local st pid name repo sid wt title key prof mode guest agent home rc where
  printf '%-8s %-7s %-12s %-10s %-36s %s\n' STATUS PID REPO AGENT SESSION NAME
  while IFS="$_YO_TAB" read -r st pid name repo sid wt title key prof mode guest agent home rc; do
    where="$repo"
    [ "$where" = "-" ] && [ "$prof" != "-" ] && where="($prof)"
    [ "$title" != "$name" ] && name="$name — $title"
    [ "$mode" = "here" ] && name="$name  (in place)"
    if [ "$home" = "home" ]; then
      case "$name" in *"(home)"*) : ;; *) name="$name  (home)" ;; esac
    fi
    printf '%-8s %-7s %-12s %-10s %-36s %s\n' "$st" "$pid" "$where" "$agent" "$sid" "$name"
  done <<EOF
$rows
EOF
  echo
  echo "ready = resumable (yo resume <name|id>, or yo resume-all); ended = quit with /exit"
  echo "(yo resume <name> still reopens it; resume-all skips it); gone = directory removed"
}

cmd_resume() {
  local query="" force_new_window=-1 model="" a
  for a in "$@"; do
    case "$a" in
      --new-window|--window) force_new_window=1 ;;
      --tab)                 force_new_window=0 ;;
      --model=*)             model="${a#--model=}"
                             [ -n "$model" ] || die "--model needs a value"
                             _yo_model_arg "$model" >/dev/null ;;
      --*) die "unknown flag: $a" ;;
      *)   [ -z "$query" ] || die "usage: yo resume [<name|session-id|dir>] [--model=M] [--new-window|--tab]"
           query="$a" ;;
    esac
  done
  if [ -z "$query" ]; then
    cmd_sessions
    return 0
  fi
  # A directory may be given relatively; the ledger holds absolute paths.
  [ -d "$query" ] && query=$(cd "$query" && pwd -P)

  _yo_sync_ledger
  local row rc=0 how
  how=$(mktemp)
  row=$(_yo_state get "$query" 2>"$how") || rc=$?
  if [ "$rc" -eq 2 ]; then
    cat "$how" >&2; rm -f "$how"
    die "be more specific (use the session id)"
  fi
  [ "$rc" -eq 0 ] || { rm -f "$how"; die "no session matches '$query' (yo sessions lists them)"; }
  local transcript_only=0
  grep -q transcript-only "$how" && transcript_only=1
  rm -f "$how"
  _yo_read_row "$row"

  case "$R_STATUS" in
    running) die "$R_NAME is already running (pid $R_PID)" ;;
    gone)    die "$R_NAME's directory is gone: $R_WT" ;;
    no-id)   die "$R_NAME has no recorded session id to resume" ;;
  esac

  if [ "$transcript_only" -eq 1 ]; then
    # Known only from its transcript: record it, so it carries a tab title,
    # joins the ledger, and comes back with the rest on the next resume-all.
    _yo_classify_dir "$R_WT"
    R_REPO="$D_REPO"; R_NAME="$D_NAME"; R_TITLE="$D_TITLE"
    R_PROFILE=$(profile_for "$D_REPO"); R_GUEST=""
    R_KEY=$(_yo_state put "$R_WT" "$R_SID" "$R_TITLE" "$R_REPO" "$R_NAME" \
      "$R_PROFILE" "$D_MODE" "") || R_KEY=""
  fi
  _yo_resume_row "$force_new_window" "$model"
  echo "==> ready."
}

cmd_resume_all() {
  local dry=0 force_new_window=-1 a
  for a in "$@"; do
    case "$a" in
      --dry-run|-n)          dry=1 ;;
      --new-window|--window) force_new_window=1 ;;
      --tab)                 force_new_window=0 ;;
      *) die "usage: yo resume-all [--dry-run] [--new-window|--tab]" ;;
    esac
  done

  _yo_sync_ledger
  local rows row n=0 skipped=""
  rows=$(_yo_state list)
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    _yo_read_row "$row"
    case "$R_STATUS" in
      ready) : ;;
      *) skipped="${skipped}  ${R_STATUS}  ${R_NAME}
"; continue ;;
    esac
    n=$((n + 1))
    if [ "$dry" -eq 1 ]; then
      echo "would resume: $R_NAME ($R_SID) in $R_WT"
    else
      _yo_resume_row "$force_new_window"
    fi
  done <<EOF
$rows
EOF
  if [ -n "$skipped" ]; then
    echo "skipped:"
    printf '%s' "$skipped"
  fi
  if [ "$dry" -eq 1 ]; then
    echo "==> $n session(s) would be resumed"
  else
    echo "==> resumed $n session(s)"
  fi
}

# --- reaching a session -------------------------------------------------------
# Brings the iTerm tab of a running claude process forward and, given a message,
# types it into that session's prompt and submits it (claude queues it if a turn
# is running). The pane is found by its tty, which `ps` reports for the process,
# so it works for any session however it was started, with nothing recorded at
# launch.
focus_running_session() {
  local pid="$1" message="${2:-}" tty result
  tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  case "$tty" in ""|"?"|"??") return 1 ;; esac
  case "$tty" in /dev/*) : ;; *) tty="/dev/$tty" ;; esac
  if [ -n "${YO_DRY_LAUNCH:-}" ]; then
    printf 'dry focus: %s%s\n' "$tty" "${message:+, then type: $message}"
    return 0
  fi
  result=$(/usr/bin/osascript - "$tty" "$message" <<'APPLESCRIPT' 2>/dev/null || true
on run argv
  set want to item 1 of argv
  set msg to item 2 of argv
  tell application "iTerm2"
    repeat with ww in windows
      repeat with tt in tabs of ww
        repeat with ss in sessions of tt
          if (tty of ss) is want then
            select ww
            tell tt to select
            tell ss to select
            activate
            if msg is not "" then
              -- Claude reads a long burst of input as a paste, and a newline
              -- inside a paste is a line break, not Enter: type the message,
              -- pause, then press Enter on its own.
              tell ss to write text msg newline no
              delay 0.5
              tell ss to write text (character id 13) newline no
            end if
            return "found"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
)
  [ "$result" = "found" ]
}

# Reaches the session in the R_* row (see _yo_read_row) with an optional
# message: a running one has its tab brought forward and the message typed in;
# a stopped one is resumed with the message as its first prompt. Returns 1 for
# a row there is nothing to reach in (gone, no id).
_yo_reach_row() {
  local message="$1" force_new_window="$2" model="$3" label="$4"
  case "$R_STATUS" in
    running)
      _yo_reach_live "$R_PID" "$message" "$label" "${R_RC:-}"
      return 0 ;;
    ready|ended)
      _yo_resume_row "$force_new_window" "$model" "$message"
      echo "==> ready."
      return 0 ;;
  esac
  return 1
}

# A running session, by its claude process: bring its tab forward and type the
# message, or say how else to reach it.
_yo_reach_live() {
  local pid="$1" message="$2" label="$3" rc="${4:-}"
  if focus_running_session "$pid" "$message"; then
    echo "==> $label is running (pid $pid): brought its tab forward${message:+ and typed your message}"
  else
    echo "==> $label is running (pid $pid), but not in an iTerm tab yo can find;"
    echo "    reach it ${rc:+by Remote Control as $rc, or }with SendMessage from another session${message:+ (your message was not delivered)}"
  fi
}

# `yo NAME ['message']` for a NAME that is a live session's Claude name or a
# session in the ledger. Returns 1 when NAME names neither, so the caller can
# create a session instead.
cmd_reach() {
  local query="$1" message="${2:-}" out rc=0 kind rest err
  err=$(mktemp)
  out=$(_yo_state reach "$query" 2>"$err") || rc=$?
  if [ "$rc" -eq 2 ]; then
    cat "$err" >&2; rm -f "$err"
    die "be more specific (use the session id)"
  fi
  rm -f "$err"
  [ "$rc" -eq 0 ] || return 1
  kind="${out%%"$_YO_TAB"*}"; rest="${out#*"$_YO_TAB"}"
  if [ "$kind" = "live" ]; then
    _yo_reach_live "${rest%%"$_YO_TAB"*}" "$message" "$query"
    return 0
  fi
  _yo_read_row "$rest"
  _yo_reach_row "$message" -1 "" "$R_NAME"
}

# The repo that is NAME's home: one keyed NAME-home, else one whose clone's
# directory is named NAME-home.
_yo_home_repo_for() {
  local want="$1-home" k
  _yo_field "$want" 1 >/dev/null 2>&1 && { printf '%s' "$want"; return 0; }
  for k in $(_yo_repo_keys); do
    [ "$(basename "$(repo_path_for "$k")")" = "$want" ] && { printf '%s' "$k"; return 0; }
  done
  return 1
}

# `yo NAME ['message']` for a NAME whose home is a repo called NAME-home: reach
# its session (see `_yo_state home`), or start one in place there, seeded with
# the message. Returns 1 when there's no such repo.
cmd_home_reach() {
  local name="$1" message="${2:-}" key dir out kind rest
  key=$(_yo_home_repo_for "$name") || return 1
  dir=$(repo_path_for "$key")
  [ -d "$dir" ] || die "$name's home, repo '$key', has no clone at $dir"
  if out=$(_yo_state home "$dir"); then
    kind="${out%%"$_YO_TAB"*}"; rest="${out#*"$_YO_TAB"}"
    if [ "$kind" = "live" ]; then
      _yo_reach_live "${rest%%"$_YO_TAB"*}" "$message" "$name's home"
      return 0
    fi
    _yo_read_row "$rest"
    _yo_reach_row "$message" -1 "" "$name's home ($R_NAME)" && return 0
  fi
  echo "==> starting a session in $name's home ($dir)"
  cmd_up --repo="$key" --here - ${message:+"$message"}
}

# True if any argument is a flag (--x).
_yo_has_flag() {
  local a
  for a in "$@"; do
    case "$a" in --*) return 0 ;; esac
  done
  return 1
}

# --- agent homes --------------------------------------------------------------
# An agent's home is one long-lived session per agent: a detached checkout of
# the repo's base branch at <clone>-worktrees/agent-<name>, run as the agent,
# reachable by Remote Control as <name>-home. It reads and coordinates; its
# changes happen in worker sessions (yo --agent=<name> --from=<name>-home ...).
# Each start moves a clean home to the newest base, so it reads current docs.
_yo_agent_home_refresh() {
  local wt="$1" remote="$2" base="$3"
  if [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
    echo "==> note: $wt has uncommitted changes; left at its current commit"
    return 0
  fi
  git -C "$wt" fetch --quiet "$remote" "$base" 2>/dev/null || true
  if git -C "$wt" checkout --quiet --detach "$remote/$base" 2>/dev/null; then
    echo "==> home at $remote/$base ($(git -C "$wt" rev-parse --short HEAD))"
  else
    echo "==> note: couldn't move $wt to $remote/$base; left at its current commit"
  fi
}

cmd_agent() {
  local name="" extra="" force_new_window=-1 model="" a
  local usage="usage: yo agent [NAME] [--model=M] [--new-window|--tab] ['message']"
  for a in "$@"; do
    case "$a" in
      --new-window|--window) force_new_window=1 ;;
      --tab)                 force_new_window=0 ;;
      --model=*)             model="${a#--model=}"
                             [ -n "$model" ] || die "--model needs a value"
                             _yo_model_arg "$model" >/dev/null ;;
      --*) die "$usage" ;;
      *)   if [ -z "$name" ]; then name="$a"
           elif [ -z "$extra" ]; then extra="$a"
           else die "$usage"; fi ;;
    esac
  done

  if [ -z "$name" ]; then
    if [ -z "$_YO_AGENTS" ]; then
      echo "no agents registered; add one under \"agents\" in $(_yo_config_path)"
      return 0
    fi
    local n r
    printf '%-14s %-12s %s\n' AGENT REPO HOME
    for n in $(_yo_agent_names); do
      r=$(_yo_agent_field "$n" 2)
      printf '%-14s %-12s %s\n' "$n" "$r" "$(repo_path_for "$r" 2>/dev/null || echo '?')-worktrees/agent-$n"
    done
    return 0
  fi

  local repo_key repo_path base_ref remote wt_path display title rc_name
  repo_key=$(_yo_agent_field "$name" 2) \
    || die "unknown agent '$name': register it under \"agents\" in $(_yo_config_path)"
  repo_path=$(repo_path_for "$repo_key") \
    || die "agent '$name' names unknown repo '$repo_key' (known: $(_yo_repo_list))"
  [ -d "$repo_path/.git" ] || die "no clone at: $repo_path"
  base_ref=$(base_ref_for "$repo_key")
  remote=$(_yo_upstream_remote "$repo_key")
  wt_path="${repo_path}-worktrees/agent-${name}"
  display=$(_yo_agent_display "$name")
  title="${display} (home)"
  rc_name="${name}-home"

  # Already recorded: bring it back rather than starting a second home.
  local row
  if row=$(_yo_state get "$wt_path" 2>/dev/null); then
    _yo_read_row "$row"
    case "$R_STATUS" in
      running)
        _yo_reach_row "$extra" "$force_new_window" "$model" "${display}'s home"
        return 0 ;;
      ready|ended)
        _yo_agent_home_refresh "$wt_path" "$remote" "$base_ref"
        _yo_reach_row "$extra" "$force_new_window" "$model" "${display}'s home"
        return 0 ;;
    esac
    # gone / no-id: start a fresh home below.
    _yo_state drop-dir "$wt_path" || true
  fi

  echo "==> fetching $remote/$base_ref"
  git -C "$repo_path" fetch --quiet "$remote" "$base_ref" || die "couldn't fetch $remote/$base_ref"
  _yo_agent_check "$name" "$repo_path" "$remote/$base_ref"
  if [ -e "$wt_path" ]; then
    git -C "$wt_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "$wt_path exists and isn't a git worktree"
    _yo_agent_home_refresh "$wt_path" "$remote" "$base_ref"
  else
    echo "==> worktree add --detach $wt_path $remote/$base_ref"
    mkdir -p "$(dirname "$wt_path")"
    git -C "$repo_path" worktree add --quiet --detach "$wt_path" "$remote/$base_ref"
  fi

  if repo_trusted "$repo_key"; then
    echo "==> pre-trusting worktree in ~/.claude.json"
    seed_trust "$wt_path" "$repo_path" \
      || echo "yo: trust-seed skipped (couldn't update ~/.claude.json; Claude will prompt)"
  else
    echo "==> not pre-trusting the worktree ($repo_key isn't a trusted repo) — Claude will ask"
  fi
  mirror_local_settings "$wt_path" "$repo_path" "$repo_key"
  mirror_repo_files "$wt_path" "$repo_path" "$repo_key"

  _yo_compose_message "" "$extra" "" "$display" "$title"
  local initial_msg="$COMPOSED_MSG" session_id session_key label claude_cmd
  session_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  session_key=$(_yo_state put "$wt_path" "$session_id" "$title" "$repo_key" \
    "agent-${name}" "$(profile_for "$repo_key")" worktree "" "$name" 1 "$rc_name") \
    || { session_key=""; echo "yo: couldn't record the session in $YO_STATE_DIR (resume-all won't know about it)"; }
  label=$(session_label "$repo_key" "$wt_path")
  prepare_claude_cmd "$repo_key" "$label" "$session_key"
  claude_cmd="$YO_CLAUDE_LINE$(_yo_model_arg "$model")$(_yo_agent_arg "$name")$(_yo_rc_arg "$rc_name") --session-id $session_id $(shell_single_quote "$initial_msg")"

  echo "        agent:   $name (Remote Control: $rc_name)"
  echo "        session: $session_id"
  [ -n "$model" ] && echo "        model:   $model"
  launch_session "$wt_path" "$title" "$claude_cmd" "$repo_key" "$label" "$force_new_window"
  echo "==> ready."
}

# --- teardown -----------------------------------------------------------------
# The ledger key of the in-place session `yo down` runs in, if it can tell:
# YO_SESSION_KEY (claude, and so the /yo-down skill, runs with it), else the
# session id claude exports to its tools, else the one in-place record for this
# directory. Empty when none or several match.
_yo_here_session_key() {
  local dir="$1" rows st pid name repo sid wt title k prof mode guest agent home rc
  local by_id="" by_dir="" n=0
  if [ -n "${YO_SESSION_KEY:-}" ]; then
    printf '%s' "$YO_SESSION_KEY"; return 0
  fi
  rows=$(_yo_state list) || return 0
  while IFS="$_YO_TAB" read -r st pid name repo sid wt title k prof mode guest agent home rc; do
    [ -n "$k" ] || continue
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "$sid" = "$CLAUDE_CODE_SESSION_ID" ] \
      && by_id="$k"
    [ "$mode" = "here" ] || continue
    case "$dir/" in "$wt/"*) : ;; *) continue ;; esac
    by_dir="$k"; n=$((n + 1))
  done <<EOF
$rows
EOF
  if [ -n "$by_id" ]; then
    printf '%s' "$by_id"
  elif [ "$n" -eq 1 ]; then
    printf '%s' "$by_dir"
  fi
  return 0
}

cmd_down() {
  # --yes skips the prompt, for running from inside the session itself (a
  # skill, or a remote-controlled claude) where nobody can answer it. Because
  # nobody is looking, --yes alone refuses to throw away uncommitted work;
  # --discard is the explicit "yes, lose it".
  local yes=0 discard=0 dry=0 a ans
  for a in "$@"; do
    case "$a" in
      --yes|-y)      yes=1 ;;
      --discard)     discard=1 ;;
      --dry-run|-n)  dry=1 ;;
      *) die "usage: yo down [--dry-run] [--yes [--discard]]" ;;
    esac
  done

  local toplevel tab_note
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "${ITERM_SESSION_ID:-}" ]; then
    tab_note="  and close this iTerm2 tab, which ends the claude session in it."
  else
    tab_note="  (not inside iTerm2: no tab to close)"
  fi

  # Not a yo worktree (a --here session, or not a git checkout at all): there
  # is nothing on disk that is ours to remove, so teardown is forgetting the
  # session and closing the tab.
  case "$(dirname "${toplevel:-/}")" in
    *-worktrees) : ;;
    *) local key
       key=$(_yo_here_session_key "$(pwd -P)")
       if [ "$dry" -eq 1 ]; then
         echo "Tearing down this session would:"
       else
         echo "About to tear down this session:"
       fi
       echo "  leave $(pwd) exactly as it is (no yo worktree here)"
       if [ -n "$key" ]; then
         echo "  forget it in yo's session ledger ($key)"
       else
         echo "  (no single ledger record for it here — yo forget <name> if one lingers)"
       fi
       echo "$tab_note"
       if [ "$dry" -eq 1 ]; then
         echo "dry run: nothing changed."
         return 0
       fi
       if [ "$yes" -eq 0 ]; then
         printf 'Close this tab? [y/N] '
         read -r ans || ans=""
         case "${ans:-}" in
           y|Y|yes|YES) : ;;
           *) echo "aborted."; return 0 ;;
         esac
       fi
       [ -n "$key" ] && { _yo_state drop "$key" || true; }
       close_iterm_own_tab
       return 0 ;;
  esac

  local home_row
  if home_row=$(_yo_state get "$toplevel" 2>/dev/null); then
    _yo_read_row "$home_row"
    [ "$R_HOME" != "home" ] || die "this is ${R_AGENT}'s home checkout, which yo keeps; quit the session with /exit instead"
  fi

  local repo_key repo_path branch dirty unpushed
  repo_key=$(detect_repo_key) || die "couldn't identify the repo from its remotes"
  repo_path=$(repo_path_for "$repo_key")
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
  dirty=$(git status --porcelain)
  local base_ref up
  up=$(_yo_upstream_remote "$repo_key")
  base_ref=$(base_ref_for "$repo_key")
  unpushed=$(git log --oneline "${up}/${base_ref}..HEAD" 2>/dev/null || true)

  if [ "$dry" -eq 1 ]; then
    echo "Tearing down this work session would:"
  else
    echo "About to tear down this work session:"
  fi
  echo "  repo:     $repo_key"
  echo "  worktree: $toplevel"
  echo "  branch:   $branch   (KEPT — not deleted)"
  if [ -n "$dirty" ]; then
    echo
    echo "  !!  UNCOMMITTED / untracked changes — these will be LOST:"
    printf '%s\n' "$dirty" | sed 's/^/        /'
  fi
  if [ -n "$unpushed" ]; then
    echo
    echo "  *   commits not on ${up}/${base_ref} (preserved on branch '$branch'):"
    printf '%s\n' "$unpushed" | sed 's/^/        /'
  fi
  echo
  echo "$tab_note"

  if [ "$dry" -eq 1 ]; then
    if [ -n "$dirty" ]; then
      echo "dry run: nothing changed. Uncommitted work means --yes alone will refuse; add --discard to lose it."
    else
      echo "dry run: nothing changed."
    fi
    return 0
  fi

  if [ "$yes" -eq 1 ]; then
    if [ -n "$dirty" ] && [ "$discard" -eq 0 ]; then
      die "refusing: uncommitted changes above would be lost. Commit/stash them, or pass --discard."
    fi
  else
    printf 'Remove the worktree and close this tab? [y/N] '
    read -r ans || ans=""
    case "${ans:-}" in
      y|Y|yes|YES) : ;;
      *) echo "aborted."; exit 0 ;;
    esac
  fi

  local force=()
  [ -n "$dirty" ] && force=(--force)

  # Step out first: the directory is about to vanish, and later commands
  # (python for the ledger) can't start in a deleted cwd.
  cd "$repo_path"
  # ${force[@]+...} guards against macOS bash 3.2, where expanding an empty
  # array under `set -u` errors with "unbound variable".
  git -C "$repo_path" worktree remove ${force[@]+"${force[@]}"} "$toplevel"
  git -C "$repo_path" worktree prune
  _yo_state drop-dir "$toplevel" || true
  echo "worktree removed; branch '$branch' kept."

  close_iterm_own_tab
}

# --- title --------------------------------------------------------------------
# A session's title lives in three places, and they drift apart if only one is
# changed: the iTerm session NAME (what Session Status lists, and what the
# Claude Code workgroup overwrites with "Chat"), user.yoTitle (what the tab
# title is pinned to by the profile), and the ledger (what resume restores).
# `yo title T` sets all three for the tab it runs in, found by ITERM_SESSION_ID
# rather than focus, so it is right when run from claude or a background tab.
# Bare `yo title` puts every yo tab's name back to its yoTitle.
cmd_title() {
  local title="${1:-}"
  [ "$#" -le 1 ] || die "usage: yo title [\"new title\"]   (quote it)"

  if [ -z "$title" ]; then
    _yo_resync_titles
    echo "==> session names reset to their yo titles"
    return 0
  fi
  [ -n "${ITERM_SESSION_ID:-}" ] || die "not inside an iTerm2 session — no tab to retitle"

  local res
  res=$(/usr/bin/osascript - "${ITERM_SESSION_ID#*:}" "$title" <<'APPLESCRIPT'
on run argv
  set want to item 1 of argv
  set newTitle to item 2 of argv
  tell application "iTerm2"
    repeat with ww in windows
      repeat with tt in tabs of ww
        set hit to false
        repeat with ss in sessions of tt
          if (unique id of ss) is want then set hit to true
        end repeat
        if hit then
          -- every pane in the tab: Session Status lists them all
          repeat with ss in sessions of tt
            tell ss
              set variable named "user.yoTitle" to newTitle
              set name to newTitle
            end tell
          end repeat
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  return "missing"
end run
APPLESCRIPT
  ) || res="error"
  [ "$res" = "ok" ] || die "couldn't find this session's iTerm tab ($res)"

  local top
  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
  _yo_state retitle "${YO_SESSION_KEY:-}" "${CLAUDE_CODE_SESSION_ID:-}" "$top" "$title" \
    || echo "yo: (not in the ledger — the title won't survive a resume; yo adopt records it)"
  # The workgroup may rename the session again shortly; hold the name for a bit.
  reassert_session_title "$title"
  echo "==> titled: $title"
}

# Every session carrying a user.yoTitle gets that as its name again.
_yo_resync_titles() {
  /usr/bin/osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
tell application "iTerm2"
  repeat with ww in windows
    repeat with tt in tabs of ww
      repeat with ss in sessions of tt
        set v to missing value
        try
          tell ss to set v to variable named "user.yoTitle"
        end try
        if v is not missing value and v is not "" then
          if (name of ss) is not v then set name of ss to v
        end if
      end repeat
    end repeat
  end repeat
end tell
APPLESCRIPT
}

# --- adopt / forget -----------------------------------------------------------
# For sessions yo didn't start, run from INSIDE them (the /yo-adopt skill): the
# session knows its own id (CLAUDE_CODE_SESSION_ID, exported to every tool
# call), so nothing has to be guessed from the process table. `yo sessions`
# adopts live sessions in yo worktrees in bulk; this also covers the ones in a
# primary clone or anywhere else.
cmd_adopt() {
  local sid="${CLAUDE_CODE_SESSION_ID:-}" title="" title_given=0 a
  for a in "$@"; do
    case "$a" in
      --session-id=*) sid="${a#--session-id=}" ;;
      --title=*)      title="${a#--title=}"; title_given=1 ;;
      *) die "usage: yo adopt [--session-id=ID] [--title=T]" ;;
    esac
  done
  [ -n "$sid" ] || die "no session id: run this from inside a claude session, or pass --session-id=ID"

  local dir
  dir=$(_yo_state launch-cwd "$sid") || dir=$(pwd -P)
  _yo_classify_dir "$dir"

  # Title: what the iTerm tab already says, when yo titled it; else derived.
  if [ -z "$title" ] && [ -n "${ITERM_SESSION_ID:-}" ]; then
    title=$(/usr/bin/osascript - "${ITERM_SESSION_ID#*:}" 2>/dev/null <<'APPLESCRIPT' || true
on run argv
  set want to item 1 of argv
  tell application "iTerm2"
    repeat with ww in windows
      repeat with tt in tabs of ww
        repeat with ss in sessions of tt
          if (unique id of ss) is want then
            try
              tell ss to set v to variable named "user.yoTitle"
              if v is not missing value then return v
            end try
            return ""
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
)
  fi
  [ -n "$title" ] || title="$D_TITLE"

  local key
  key=$(_yo_state adopt "$D_DIR" "$sid" "$title" "$title_given" "$D_REPO" "$D_NAME" \
    "$(profile_for "$D_REPO")" "$D_MODE") \
    || die "couldn't write the ledger in $YO_STATE_DIR"
  local row
  row=$(_yo_state get "$sid") && _yo_read_row "$row"
  echo "==> recorded: ${R_TITLE:-$title}"
  echo "        session: $sid"
  echo "        dir:     ${R_WT:-$D_DIR}"
  echo "    yo resume-all will bring it back after a restart."
}

cmd_forget() {
  local query="${1:-}" row
  [ -n "$query" ] || die "usage: yo forget <name|session-id|dir>"
  [ -d "$query" ] && query=$(cd "$query" && pwd -P)
  row=$(_yo_state get "$query" 2>/dev/null) \
    || die "no single session matches '$query' (yo sessions lists them)"
  _yo_read_row "$row"
  [ "$R_KEY" != "-" ] || die "'$query' isn't in the ledger; nothing to forget"
  [ "$R_STATUS" != "running" ] || echo "yo: note: $R_NAME is still running; forgetting it only stops resume-all bringing it back"
  _yo_state drop "$R_KEY" || die "couldn't find a record for $R_SID"
  echo "forgot $R_NAME ($R_SID); its transcript and directory are untouched"
}

# --- sweep --------------------------------------------------------------------
# `yo down` is the only thing that removes a worktree, so sessions that end any
# other way leave theirs behind. Sweep removes the ones whose work has landed —
# and never one a session still needs. The rules live in `_yo_state sweep`.
cmd_sweep() {
  local spec="" k gh
  for k in $(_yo_repo_keys); do
    gh=$(_yo_github_for "$k" 2>/dev/null || true)
    [ -n "$gh" ] || echo "yo: no owner/repo for '$k' — its PRs can't be checked, so merged branches read as unmerged" >&2
    spec="${spec}${k}${_YO_TAB}$(repo_path_for "$k")${_YO_TAB}$(base_ref_for "$k")${_YO_TAB}${gh}${_YO_TAB}$(_yo_upstream_remote "$k")
"
  done
  # Adopt live sessions first, so a session yo didn't start still holds its
  # worktree through the ledger, not only through its running process.
  _yo_sync_ledger
  YO_SWEEP_REPOS="$spec" _yo_state sweep "$@"
}

# --- config -------------------------------------------------------------------
cmd_config() {
  local sub="${1:-show}" cfg
  [ "$#" -eq 0 ] || shift
  cfg=$(_yo_config_path)
  case "$sub" in
    show)
      if [ -f "$cfg" ]; then
        echo "config: $cfg"
      else
        echo "config: none yet ($cfg)"
      fi
      _yo_print_registry ;;
    path) printf '%s\n' "$cfg" ;;
    edit)
      [ -f "$cfg" ] || printf '{}\n' > "$cfg"
      "${EDITOR:-vi}" "$cfg"
      _yo_cfg load "$cfg" >/dev/null && echo "==> $cfg is valid" ;;
    add-repo) _yo_config_add_repo "$@" ;;
    *) die "usage: yo config [show | path | edit | add-repo <clone|url|owner/repo> [--profile=P] [--key=K]]" ;;
  esac
}

# yo config add-repo <clone dir | github URL | owner/repo> [--profile=P] [--key=K]
# A directory is listed where it is; anything else is cloned to
# <cloneRoot>/<owner>/<repo> first (or found there).
_yo_config_add_repo() {
  local target="" profile="" key="" a cfg path gh="" r url
  for a in "$@"; do
    case "$a" in
      --profile=*) profile="${a#--profile=}" ;;
      --key=*)     key="${a#--key=}" ;;
      --*) die "unknown flag: $a" ;;
      *)   [ -z "$target" ] || die "usage: yo config add-repo <clone|url|owner/repo> [--profile=P] [--key=K]"
           target="$a" ;;
    esac
  done
  [ -n "$target" ] || die "usage: yo config add-repo <clone|url|owner/repo> [--profile=P] [--key=K]"
  cfg=$(_yo_config_path)
  [ -z "$profile" ] || _yo_pfield "$profile" 1 >/dev/null 2>&1 \
    || die "no profile '$profile' (profiles: $(_yo_profile_names | paste -sd' ' -))"

  if [ -d "$target" ]; then
    path=$(cd "$target" && pwd -P)
    [ -e "$path/.git" ] || die "$path isn't a git clone"
    for r in upstream origin; do
      url=$(git -C "$path" remote get-url "$r" 2>/dev/null) || continue
      gh=$(_yo_owner_repo_from_url "$url") && break
      gh=""
    done
  else
    case "$target" in
      *github.com*) gh=$(_yo_owner_repo_from_url "$target") || die "not a github repo URL: $target" ;;
      */*)          gh="$target" ;;
      *)            die "not a directory, URL or owner/repo: $target" ;;
    esac
    gh="${gh%.git}"
    if r=$(repo_key_from_url "https://github.com/$gh" 2>/dev/null); then
      echo "==> $gh is already registered as '$r' ($(repo_path_for "$r"))"
      return 0
    fi
    register_url_repo "$gh" "${profile:-}"
    path=$(repo_path_for "$YO_URL_REPO")
  fi

  if r=$(_yo_repo_at "$path" 2>/dev/null) && [ "$r" != "$YO_URL_REPO" ] && [ "$r" != "$_YO_AUTOREG" ]; then
    echo "==> $path is already registered as '$r'"
    return 0
  fi
  [ -n "$key" ] || key="${YO_URL_REPO:-$(basename "$path")}"
  case "$key" in *[!A-Za-z0-9._-]*) die "key may only contain letters, digits, . _ - (got: '$key')" ;; esac
  if [ "$key" != "$YO_URL_REPO" ] && [ "$key" != "$_YO_AUTOREG" ] && _yo_field "$key" 1 >/dev/null 2>&1; then
    die "there's already a repo called '$key'; pick another with --key=K"
  fi
  _yo_cfg add-repo "$cfg" "$profile" "$key" "$path" "$gh" || die "couldn't write $cfg"
  echo "==> added '$key' ($path)${profile:+ to profile '$profile'} in $cfg"
}

# --- dispatch -----------------------------------------------------------------
main() {
  local sub="${1:-}"
  # The ledger hooks run at every claude start and exit, so they skip config
  # loading entirely: fast, and they can't fail on a config problem.
  if [ "$sub" = "_session-hook" ]; then
    # The payload arrives on stdin, but python3 reads its program from stdin
    # (the heredoc), so it's handed over through the environment instead.
    YO_HOOK_INPUT="$(cat)" _yo_state hook || true
    exit 0
  fi
  # Help must work even outside a clone with no config, so it loads softly.
  case "$sub" in
    help|-h|--help) _yo_load_config 1; _yo_apply_defaults; usage; exit 0 ;;
  esac
  # Softly here too: a session in place needs no repo at all, and neither does
  # closing a tab. cmd_up complains itself when a worktree has no repo to come
  # from.
  _yo_load_config 1
  _yo_apply_defaults
  case "$sub" in
    down|rm|teardown|-d) shift; cmd_down "$@" ;;
    resume|--resume)     shift; cmd_resume "$@" ;;
    resume-all)          shift; cmd_resume_all "$@" ;;
    sessions|ls)         shift; cmd_sessions "$@" ;;
    sweep)               shift; cmd_sweep "$@" ;;
    adopt)               shift; cmd_adopt "$@" ;;
    title)               shift; cmd_title "$@" ;;
    forget)              shift; cmd_forget "$@" ;;
    agent)               shift; cmd_agent "$@" ;;
    config)              shift; cmd_config "$@" ;;
    *)
      # `yo NAME ['message']` with no flags reaches what NAME names: a registered
      # agent's home, a live session by its Claude name, a ledger session, or
      # the session in a repo called NAME-home. A repo or profile name keeps
      # its positional meaning (`yo <repo>`), and anything else, or any flag,
      # creates a session as before.
      if [ "$#" -ge 1 ] && [ "$#" -le 2 ] && ! _yo_has_flag "$@" \
          && ! _yo_field "$1" 1 >/dev/null 2>&1 \
          && ! _yo_pfield "$1" 1 >/dev/null 2>&1; then
        if _yo_agent_field "$1" 1 >/dev/null 2>&1; then
          cmd_agent "$@"
        elif ! cmd_reach "$@" && ! cmd_home_reach "$@"; then
          cmd_up "$@"
        fi
      else
        cmd_up "$@"
      fi ;;
  esac
}

main "$@"
